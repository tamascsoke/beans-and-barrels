---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SideTab from "../components/SideTab.astro";
import ChalkBackground from "../components/ChalkBackground.astro";
import ScrollExtras from "../components/ScrollExtras.astro";
import EasterEggs from "../components/EasterEggs.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource/league-gothic/400.css";
import "@fontsource/league-spartan/700.css";
import "@fontsource/league-spartan/800.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Bean & Barrel — Kávé és Sör",
  description = "Bean & Barrel — tuktuk kávézó és söröző. Rendezvények, franchise, közösség.",
  image = "/og-image.webp",
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, "https://www.beanbarrel.coffee").toString();
const socialImage = new URL(image, "https://www.beanbarrel.coffee").toString();
const showSideTab = !Astro.url.pathname.startsWith("/kontakt");
const businessSchema = Astro.url.pathname === "/" ? {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  name: "Bean & Barrel",
  url: "https://www.beanbarrel.coffee",
  email: "info@beanbarrel.coffee",
  telephone: "+36 20 246 9775",
  description,
  servesCuisine: ["Specialty kávé", "Csapolt sör", "Rendezvény vendéglátás"],
  image: socialImage,
  address: {
    "@type": "PostalAddress",
    addressCountry: "HU",
  },
} : null;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/handelson-five.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#363535" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:site_name" content="Bean & Barrel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {businessSchema && <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Ugrás a tartalomra</a>
    <ChalkBackground />
    <Nav />
    <main id="main">
      <slot />
    </main>
    {showSideTab && <SideTab />}
    <ScrollExtras />
    <EasterEggs />
    <Footer />
  </body>
</html>

<script>
  let layoutAbort: AbortController | null = null;

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function scrollBehavior() {
    return prefersReducedMotion() ? "auto" : "smooth";
  }

  /* ── Per-page inits (re-run after each navigation) ── */
  function initObservers() {
    layoutAbort?.abort();
    layoutAbort = new AbortController();
    const { signal } = layoutAbort;
    const observers: IntersectionObserver[] = [];
    const track = (io: IntersectionObserver) => {
      observers.push(io);
      signal.addEventListener("abort", () => io.disconnect(), { once: true });
      return io;
    };

    // chalk underline draw-in
    const chalkIO = track(new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-drawn"); chalkIO.unobserve(e.target); }
      }),
      { threshold: 0.35 },
    ));
    document.querySelectorAll(".chalk-underline:not(.is-drawn)").forEach((el) => chalkIO.observe(el));

    // section reveal
    const revealIO = track(new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.animationDelay =
            (e.target as HTMLElement).dataset.delay ?? "0ms";
          e.target.classList.add("is-visible");
          revealIO.unobserve(e.target);
        }
      }),
      { threshold: 0.15 },
    ));
    document.querySelectorAll(".reveal:not(.is-visible), .stagger:not(.is-visible)").forEach((el) => revealIO.observe(el));

    // hero lead — CSS reveal (no char-by-char repaint)
    const leadIO = track(new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add("is-revealed");
        leadIO.unobserve(e.target);
      }),
      { threshold: 0.35 },
    ));
    document.querySelectorAll<HTMLElement>("[data-typewriter]:not(.is-revealed)").forEach((el) => {
      if (prefersReducedMotion()) {
        el.classList.add("is-revealed");
        return;
      }
      leadIO.observe(el);
    });

    // section chalk-dust reveal
    const sectionIO = track(new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); sectionIO.unobserve(e.target); }
      }),
      { threshold: 0.08 }
    ));
    document.querySelectorAll("section:not(.is-visible)").forEach((el) => {
      el.classList.add("chalk-section");
      sectionIO.observe(el);
    });

    // split text on h-display headings
    document.querySelectorAll<HTMLElement>(".h-display:not([data-split])").forEach((el) => {
      el.dataset.split = "1";
      const inner = (el.querySelector(".chalk-underline") as HTMLElement) ?? el;
      const text = inner.textContent?.trim() ?? "";
      inner.innerHTML = "";
      text.split(/\s+/).forEach((w, i) => {
        const s = document.createElement("span");
        s.className = "sw";
        s.textContent = w;
        s.style.transitionDelay = `${i * 90}ms`;
        inner.appendChild(s);
        inner.appendChild(document.createTextNode(" "));
      });
      const io = track(new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { el.classList.add("sw-vis"); io.disconnect(); }
      }, { threshold: 0.15 }));
      io.observe(el);
    });

    // heading chalk-write reveal
    const writeIO = track(new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-written"); writeIO.unobserve(e.target); }
      }),
      { threshold: 0 }
    ));
    document.querySelectorAll(".h-display:not(.is-written)").forEach((el) => {
      el.classList.add("chalk-write");
      writeIO.observe(el);
    });

    document.addEventListener("astro:before-swap", () => {
      layoutAbort?.abort();
      observers.forEach((io) => io.disconnect());
    }, { once: true, signal });
  }

  function scrollToCurrentHash() {
    const id = decodeURIComponent(window.location.hash.replace(/^#/, ""));
    if (!id) return;
    window.requestAnimationFrame(() => {
      document.getElementById(id)?.scrollIntoView({ block: "start", behavior: scrollBehavior() });
    });
  }

  initObservers();
  document.addEventListener("astro:after-swap", initObservers);
  document.addEventListener("astro:after-swap", scrollToCurrentHash);
  window.addEventListener("hashchange", scrollToCurrentHash);
  scrollToCurrentHash();

</script>

<style is:global>
  /* ── Page transition: chalk slide-fade ── */
  @keyframes page-out {
    from { opacity: 1; transform: translateX(0);     filter: blur(0); }
    to   { opacity: 0; transform: translateX(-28px); filter: blur(6px); }
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateX(28px);  filter: blur(6px); }
    to   { opacity: 1; transform: translateX(0);     filter: blur(0); }
  }
  ::view-transition-old(root) { animation: 260ms ease-in  forwards page-out; }
  ::view-transition-new(root) { animation: 360ms 150ms ease-out both page-in; }

  /* ── Section chalk-dust reveal ── */
  .chalk-section {
    opacity: 1;
    transform: none;
    filter: none;
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.7s var(--ease);
  }
  .chalk-section.is-visible {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* ── Heading chalk-write reveal ── */
  @keyframes chalk-write-anim {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0% 0 0); }
  }
  .chalk-write.is-written {
    animation: chalk-write-anim 1.1s var(--ease) both;
  }

  /* ── Split text words ── */
  .sw {
    display: inline-block;
    opacity: 1;
    transform: none;
    transition: opacity 650ms var(--ease), transform 650ms var(--ease);
  }
  .sw-vis .sw { opacity: 1; transform: none; }

  :target {
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

</style>
