---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { getCategories, resolveImage } from "../lib/content";
import tuktukKaveImg from '../assets/uploads/tuktuk-kave.webp';

const categories = getCategories();
---

<Layout title="Kínálat — Bean & Barrel">
  <section class="section kinalat-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="h-display"><span class="chalk-underline">Egy tuktuk, négy világ</span></h1>
        <p class="lead">Specialty kávé, csapolt SÖR, snackek és szezonális italok egy mozgó pultból.</p>
        <div class="inline-action hero-action">
          <a class="btn" href="/rendezvenyek">Kérd rendezvényre</a>
        </div>
      </div>
      <div class="photo-frame hero-img"><Image src={tuktukKaveImg} alt="Bean & Barrel tuktuk kínálat" widths={[400, 700]} sizes="(min-width: 820px) 50vw, 100vw" loading="eager" fetchpriority="high" /></div>
    </div>

  </section>

  <section class="section section--last">
    <div class="container categories">
      {
        categories.map((c) => (
          <article class="cat" id={`cat-${c.key}`}>
            {c.image && resolveImage(c.image)
              ? <div class="photo-frame cat__art"><Image src={resolveImage(c.image)!} alt={c.imageAlt ?? c.label} widths={[400, 700]} sizes="(min-width: 820px) 50vw, 100vw" loading="lazy" /></div>
              : <div class="cat__art placeholder-img">Kép — {c.label}</div>
            }
            <div class="cat__copy">
              <h2 class="h-section"><span class="chalk-underline">{c.label}</span></h2>
              <ul class="cat__list chalk-list chalk-list--ruled">
                {c.items.map((it) => <li><span>{it}</span></li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .kinalat-hero {
    display: grid;
    align-items: start;
    padding-block: clamp(20px, 3vw, 36px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3.5vw, 32px);
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
  }
  .hero-copy { display: grid; gap: 18px; }
  .hero-img { aspect-ratio: 4 / 3; }

  .categories { display: grid; gap: clamp(28px, 6vw, 64px); }
  .cat {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    padding-block: clamp(24px, 4vw, 46px);
    border-top: 1px solid var(--line);
  }
  .cat:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 820px) {
    .cat { grid-template-columns: 1.1fr 1fr; }
    .cat:nth-child(even) .cat__art { order: 2; }
  }
  .cat__art { aspect-ratio: 4 / 3; width: 100%; }
  .cat__copy { display: grid; gap: 14px; align-content: center; align-self: center; }
  .cat__copy h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    text-transform: none;
  }
  .cat__list {
    margin-top: 4px;
  }
</style>
