---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SideTab from "../components/SideTab.astro";
import ChalkCursor from "../components/ChalkCursor.astro";
import ChalkBackground from "../components/ChalkBackground.astro";
import ScrollExtras from "../components/ScrollExtras.astro";
import TuktukProgress from "../components/TuktukProgress.astro";
import EasterEggs from "../components/EasterEggs.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bean & Barrel — Kávé és Sör",
  description = "Bean & Barrel — tuktuk kávézó és söröző. Rendezvények, franchise, közösség.",
} = Astro.props;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Gothic&family=League+Spartan:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <ChalkBackground />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <SideTab />
    <ScrollExtras />
    <TuktukProgress />
    <EasterEggs />
    <ChalkCursor />
    <Footer />
  </body>
</html>

<script>
  /* ── Global one-time inits (survive page swaps via astro:after-swap) ── */

  // Parallax — single global listener, queries [data-parallax] each frame
  if (!document.body.dataset.parallaxInit && window.matchMedia("(pointer:fine)").matches) {
    document.body.dataset.parallaxInit = "1";
    let ticking = false;
    document.addEventListener("mousemove", (e) => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const xPct = e.clientX / window.innerWidth  - 0.5;
        const yPct = e.clientY / window.innerHeight - 0.5;
        document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
          const d = parseFloat(el.dataset.parallax ?? "1");
          el.style.transform = `translate(${xPct * d * -22}px, ${yPct * d * -10}px)`;
        });
        ticking = false;
      });
    });
  }

  /* ── Per-page inits (re-run after each navigation) ── */
  function initObservers() {
    // chalk underline draw-in
    const chalkIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-drawn"); chalkIO.unobserve(e.target); }
      }),
      { threshold: 0.35 },
    );
    document.querySelectorAll(".chalk-underline").forEach((el) => chalkIO.observe(el));

    // section reveal
    const revealIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.animationDelay =
            (e.target as HTMLElement).dataset.delay ?? "0ms";
          e.target.classList.add("is-visible");
          revealIO.unobserve(e.target);
        }
      }),
      { threshold: 0.15 },
    );
    document.querySelectorAll(".reveal, .stagger").forEach((el) => revealIO.observe(el));

    // typewriter
    document.querySelectorAll<HTMLElement>("[data-typewriter]").forEach((el) => {
      if (el.dataset.twDone) return;
      el.dataset.twDone = "1";
      const text = el.textContent ?? "";
      el.textContent = "";
      const cursor = document.createElement("span");
      cursor.className = "tw-cursor";
      el.appendChild(cursor);
      let i = 0;
      const twIO = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        twIO.disconnect();
        function type() {
          if (i < text.length) { cursor.before(text[i++]); setTimeout(type, 26 + Math.random() * 18); }
          else cursor.classList.add("tw-done");
        }
        type();
      }, { threshold: 0.6 });
      twIO.observe(el);
    });

    // magnetic buttons — fine pointer only (avoid stuck transform on touch)
    const hasFinePointer = window.matchMedia("(hover:hover) and (pointer:fine)").matches;
    if (hasFinePointer) document.querySelectorAll<HTMLElement>(".btn").forEach((btn) => {
      btn.addEventListener("mousemove", (e) => {
        const r  = btn.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width  / 2)) * 0.28;
        const dy = (e.clientY - (r.top  + r.height / 2)) * 0.28 - 2;
        btn.style.transform = `translate(${dx}px,${dy}px)`;
        btn.style.boxShadow = btn.classList.contains("btn--ghost")
          ? "none"
          : `0 12px 34px rgba(240,138,28,0.4)`;
      });
      btn.addEventListener("mouseleave", () => {
        btn.style.transform = "";
        btn.style.boxShadow = "";
      });
    });

    // section chalk-dust reveal
    const sectionIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); sectionIO.unobserve(e.target); }
      }),
      { threshold: 0.08 }
    );
    document.querySelectorAll("section:not(.is-visible)").forEach((el) => {
      el.classList.add("chalk-section");
      sectionIO.observe(el);
    });


    // split text on h-display headings
    document.querySelectorAll<HTMLElement>(".h-display:not([data-split])").forEach((el) => {
      el.dataset.split = "1";
      const inner = (el.querySelector(".chalk-underline") as HTMLElement) ?? el;
      const text = inner.textContent?.trim() ?? "";
      inner.innerHTML = "";
      text.split(/\s+/).forEach((w, i) => {
        const s = document.createElement("span");
        s.className = "sw";
        s.textContent = w;
        s.style.transitionDelay = `${i * 90}ms`;
        inner.appendChild(s);
        inner.appendChild(document.createTextNode(" "));
      });
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { el.classList.add("sw-vis"); io.disconnect(); }
      }, { threshold: 0.15 });
      io.observe(el);
    });

    // heading chalk-write reveal
    const writeIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-written"); writeIO.unobserve(e.target); }
      }),
      { threshold: 0 }
    );
    document.querySelectorAll(".h-display:not(.is-written)").forEach((el) => {
      el.classList.add("chalk-write");
      writeIO.observe(el);
    });

  }

  initObservers();
  document.addEventListener("astro:after-swap", initObservers);

</script>

<style is:global>
  /* ── Page transition: chalk slide-fade ── */
  @keyframes page-out {
    from { opacity: 1; transform: translateX(0);     filter: blur(0); }
    to   { opacity: 0; transform: translateX(-28px); filter: blur(6px); }
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateX(28px);  filter: blur(6px); }
    to   { opacity: 1; transform: translateX(0);     filter: blur(0); }
  }
  ::view-transition-old(root) { animation: 260ms ease-in  forwards page-out; }
  ::view-transition-new(root) { animation: 360ms 150ms ease-out both page-in; }

  /* ── Typewriter cursor ── */
  .tw-cursor {
    display: inline-block;
    width: 2px; height: 0.9em;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: text-bottom;
    animation: tw-blink 0.75s step-end infinite;
  }
  .tw-cursor.tw-done { opacity: 0; animation: none; }
  @keyframes tw-blink { 50% { opacity: 0; } }

  /* ── Parallax elements: smooth follow ── */
  [data-parallax] {
    transition: transform 120ms ease-out;
    will-change: transform;
  }

  /* ── Section chalk-dust reveal ── */
  .chalk-section {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(3px);
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.7s var(--ease);
  }
  .chalk-section.is-visible {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* ── Heading chalk-write reveal ── */
  @keyframes chalk-write-anim {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0% 0 0); }
  }
  .chalk-write.is-written {
    animation: chalk-write-anim 1.1s var(--ease) both;
  }

  /* ── Split text words ── */
  .sw {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 650ms var(--ease), transform 650ms var(--ease);
  }
  .sw-vis .sw { opacity: 1; transform: none; }

</style>
