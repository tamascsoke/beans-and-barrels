---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from 'astro:assets';
import { getGalleryPhotos, resolveImage } from "../lib/content";

const photos = getGalleryPhotos();
const hasPhotos = photos.length > 0;
const placeholders = Array.from({ length: 8 }, (_, i) => i + 1);

const enriched = await Promise.all(photos.map(async (p) => {
  const asset = resolveImage(p.image);
  const fullSrc = asset
    ? (await getImage({ src: asset, width: 1400, format: 'webp' })).src
    : p.image;
  return { ...p, asset, fullSrc };
}));
---

<Layout title="Galéria — Bean & Barrel" description="Bean & Barrel képgaléria — pillanatok a tuktukkal.">
  <section class="section section--last gal-page">
    <div class="container gal-head stagger">
      <span class="h-sub">Képek</span>
      <h1 class="h-display"><span class="chalk-underline">Galéria</span></h1>
    </div>

    <div class="container gal-masonry">
      {hasPhotos ? (
        enriched.map((p, i) => (
          <div class="gal-frame" data-src={p.fullSrc} data-alt={p.alt} data-idx={i} tabindex="0" role="button" aria-label={p.alt}>
            {p.asset
              ? <Image src={p.asset} alt={p.alt} widths={[300, 600]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw" loading="lazy" />
              : <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
            }
          </div>
        ))
      ) : (
        placeholders.map((n) => (
          <div class="gal-frame gal-frame--ph">
            <span>Kép {n}</span>
          </div>
        ))
      )}
    </div>
    <div class="container gal-action">
      <div class="inline-action inline-action--center">
        <a class="btn" href="/rendezvenyek">Rendelj meg rendezvényedre!</a>
      </div>
    </div>
  </section>

  {hasPhotos && (
    <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Képnéző" inert>
      <button class="lightbox__close" id="lbClose" aria-label="Bezárás">✕</button>
      <button class="lightbox__prev"  id="lbPrev"  aria-label="Előző">‹</button>
      <button class="lightbox__next"  id="lbNext"  aria-label="Következő">›</button>
      <figure class="lightbox__fig">
        <img id="lbImg" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" />
        <figcaption id="lbCaption" class="lightbox__caption"></figcaption>
      </figure>
    </div>
  )}
</Layout>

<style>
  .gal-head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(28px, 5vw, 52px);
  }

  .gal-page {
    padding-top: clamp(56px, 8vw, 104px);
  }

  .gal-action {
    display: flex;
    justify-content: center;
    margin-top: clamp(18px, 3vw, 32px);
  }

  /* ── Masonry ── */
  .gal-masonry {
    columns: 2;
    column-gap: 14px;
  }
  @media (min-width: 640px)  { .gal-masonry { columns: 3; } }
  @media (min-width: 1024px) { .gal-masonry { columns: 4; } }

  .gal-frame {
    break-inside: avoid;
    margin-bottom: 14px;
    overflow: hidden;
    border-radius: var(--r-md);
    cursor: pointer;
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--panel-border);
    box-shadow: var(--panel-shadow);
  }

  .gal-frame img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 500ms var(--ease);
  }

  .gal-frame:hover img,
  .gal-frame:focus-visible img {
    transform: scale(1.04);
  }

  .gal-frame:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* placeholder variant */
  .gal-frame--ph {
    aspect-ratio: 4 / 3;
    cursor: default;
    background-image:
      linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02)),
      repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0 12px, transparent 12px 24px);
    border: 1px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    font-size: 0.85rem;
    letter-spacing: clamp(0.16em, 0.8vw, 0.3em);
    text-transform: uppercase;
  }
  .gal-frame--ph span { pointer-events: none; }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.93);
    z-index: 200;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__fig {
    display: grid;
    gap: 12px;
    max-width: min(92vw, 1280px);
    max-height: 92vh;
    place-items: center;
  }

  .lightbox__fig img {
    max-width: 100%;
    max-height: 84vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-md);
    display: block;
    box-shadow: 0 24px 80px rgba(0,0,0,0.7);
  }

  .lightbox__caption {
    font-family: var(--f-body);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: center;
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.08);
    border-radius: 50%;
    transition: background 180ms var(--ease), transform 180ms var(--ease);
  }
  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    background: rgba(255,255,255,0.16);
    transform: scale(1.08);
  }

  .lightbox__close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
    width: 52px;
    height: 52px;
    font-size: 1.8rem;
    line-height: 1;
  }
  .lightbox__prev { left: 16px; }
  .lightbox__next { right: 16px; }
</style>

<script>
  import { getFocusable, setInert, trapFocus } from "../lib/overlay-a11y";

  function initGalleryPage() {
    const frames    = Array.from(document.querySelectorAll(".gal-frame[data-src]")) as HTMLElement[];
    const lightbox  = document.getElementById("lightbox");
    const lbImg     = document.getElementById("lbImg")     as HTMLImageElement | null;
    const lbCaption = document.getElementById("lbCaption") as HTMLElement | null;
    const lbClose   = document.getElementById("lbClose");
    const lbPrev    = document.getElementById("lbPrev");
    const lbNext    = document.getElementById("lbNext");

    if (!lightbox || !lbImg || frames.length === 0) return;

    let current = 0;
    let releaseTrap: (() => void) | null = null;
    let lastFocus: HTMLElement | null = null;

    function show(idx: number) {
      current = ((idx % frames.length) + frames.length) % frames.length;
      const f = frames[current];
      if (lightbox.getAttribute("aria-hidden") === "true") {
        lastFocus = document.activeElement as HTMLElement | null;
      }
      lbImg!.src = f.dataset.src ?? "";
      lbImg!.alt = f.dataset.alt ?? "";
      if (lbCaption) lbCaption.textContent = f.dataset.alt ?? "";
      lightbox!.setAttribute("aria-hidden", "false");
      setInert(lightbox, false);
      document.body.classList.add("has-lightbox-open");
      document.body.style.overflow = "hidden";
      releaseTrap?.();
      releaseTrap = trapFocus(lightbox);
      getFocusable(lightbox)[0]?.focus();
    }

    function hide() {
      lightbox!.setAttribute("aria-hidden", "true");
      setInert(lightbox, true);
      document.body.classList.remove("has-lightbox-open");
      document.body.style.overflow = "";
      releaseTrap?.();
      releaseTrap = null;
      lastFocus?.focus();
      lastFocus = null;
    }

    frames.forEach((f, i) => {
      f.addEventListener("click", () => show(i));
      f.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") show(i); });
    });

    lbClose?.addEventListener("click", hide);
    lbPrev?.addEventListener("click",  () => show(current - 1));
    lbNext?.addEventListener("click",  () => show(current + 1));

    lightbox.addEventListener("click", (e) => { if (e.target === lightbox) hide(); });

    document.addEventListener("keydown", (e) => {
      if (lightbox.getAttribute("aria-hidden") === "true") return;
      if (e.key === "Escape")      hide();
      if (e.key === "ArrowLeft")   show(current - 1);
      if (e.key === "ArrowRight")  show(current + 1);
    });

    document.addEventListener("astro:before-swap", hide, { once: true });
  }

  initGalleryPage();
  document.addEventListener("astro:after-swap", initGalleryPage);
</script>
