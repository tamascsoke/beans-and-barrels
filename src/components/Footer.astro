---
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from "../lib/contact";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid stagger">
    <div class="footer__col">
      <div class="footer__brand">BEAN &amp; BARREL</div>
      <p class="body-text footer__tag">Kávé és sör — tuktukból, közösségből.</p>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Helyszínek</h4>
      <ul class="footer__list">
        <li>Budapest — bejelentés alatt</li>
        <li>Veszprém — bejelentés alatt</li>
        <li>Balaton — szezonális</li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kapcsolat</h4>
      <ul class="footer__list">
        <li><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kövess minket</h4>
      <ul class="footer__list footer__social">
        <li><span class="footer__soon">Instagram — hamarosan</span></li>
        <li><span class="footer__soon">Facebook — hamarosan</span></li>
        <li><span class="footer__soon">TikTok — hamarosan</span></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom container">
    <span>© {year} Bean &amp; Barrel</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(60px, 10vw, 120px);
    padding-block: clamp(40px, 6vw, 70px) 24px;
    border-top: 1px solid var(--line);
    background: var(--bg-2);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer__brand {
    font-family: var(--f-logo);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .footer__tag {
    max-width: 28ch;
  }

  .footer__col h4 {
    margin-bottom: 14px;
  }

  .footer__list {
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .footer__list a:hover {
    color: var(--accent);
  }
  .footer__soon {
    color: var(--ink-faint);
    font-style: italic;
  }

  .footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer__legal:hover {
    color: var(--accent);
  }
</style>
