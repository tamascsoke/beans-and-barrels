---
import idleContent from "../content/idle.json";
---

<!-- Keyboard toast -->
<div id="ee-toast" role="status" aria-live="polite" aria-atomic="true"></div>

<!-- SVG chalk filter -->
<svg width="0" height="0" aria-hidden="true" style="position:absolute;pointer-events:none">
  <defs>
    <filter id="chalk-tex" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.75 0.5" numOctaves="3" seed="7" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.2" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </defs>
</svg>

<!-- Chalk dust canvas -->
<canvas id="ee-canvas" aria-hidden="true"></canvas>

<!-- Idle overlay -->
<div id="ee-idle" aria-hidden="true">
  <div class="ee-lens">
    <div class="ee-lens__vignette"></div>
    <div class="ee-story" style="filter: url(#chalk-tex)">
      <div class="ee-story__title" id="ee-title" data-eetext={idleContent.title}></div>
      <div class="ee-story__text"  id="ee-text"  data-eetext={idleContent.text}></div>
    </div>
  </div>
</div>

<style>
  /* ── Toast ── */
  #ee-toast {
    position: fixed;
    bottom: 88px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(26, 25, 25, 0.94);
    border: 1px solid rgba(240, 138, 28, 0.35);
    color: var(--ink);
    font-family: var(--f-body);
    font-size: 1rem;
    letter-spacing: 0.15em;
    padding: 10px 24px;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease), transform 300ms var(--ease);
    z-index: 200;
    white-space: nowrap;
  }
  #ee-toast.is-shown {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Chalk canvas ── */
  #ee-canvas {
    position: fixed;
    inset: 0;
    z-index: 299;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms;
  }
  #ee-canvas.is-active { opacity: 1; }

  /* ── Idle overlay ── */
  #ee-idle {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  #ee-idle.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .ee-lens {
    width: 100%;
    height: 100%;
    background: rgba(10, 9, 9, 0.82);
    backdrop-filter: blur(8px) brightness(0.38) saturate(50%);
    -webkit-backdrop-filter: blur(8px) brightness(0.38) saturate(50%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ee-lens__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 75% at 50% 50%,
      transparent 20%,
      rgba(0,0,0,0.45) 65%,
      rgba(0,0,0,0.88) 100%
    );
    pointer-events: none;
  }

  /* ── Story block ── */
  .ee-story {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: min(680px, 88vw);
    text-align: center;
    padding: var(--gutter);
  }

  .ee-story__title {
    font-family: var(--f-logo);
    font-size: clamp(1.8rem, 5vw, 3.6rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1;
    min-height: 1em;
  }

  .ee-story__text {
    font-family: var(--f-body);
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    line-height: 1.65;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    min-height: 3em;
  }
</style>

<script>
  // ── Keyboard easter egg ──
  let kbBuffer = "";
  const KW = [
    { triggers: ["kávé", "kave"], msg: "☕ Jó ízlés!" },
    { triggers: ["sör",  "sor"],  msg: "🍺 Egészségedre!" },
  ];
  let toastTimeout: ReturnType<typeof setTimeout> | null = null;

  function showToast(msg: string) {
    const toast = document.getElementById("ee-toast");
    if (!toast) return;
    if (toastTimeout) clearTimeout(toastTimeout);
    toast.textContent = msg;
    toast.classList.add("is-shown");
    toastTimeout = setTimeout(() => toast.classList.remove("is-shown"), 2600);
  }

  document.addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const ch = e.key.length === 1 ? e.key.toLowerCase() : "";
    if (!ch) return;
    kbBuffer = (kbBuffer + ch).slice(-8);
    for (const kw of KW) {
      if (kw.triggers.some((t) => kbBuffer.endsWith(t))) {
        showToast(kw.msg);
        kbBuffer = "";
        break;
      }
    }
  });

  // ── Chalk canvas dust ──
  let chalkCanvas: HTMLCanvasElement | null = null;
  let chalkCtx: CanvasRenderingContext2D | null = null;
  let fadeRAF: number | null = null;

  function initChalkCanvas() {
    chalkCanvas = document.getElementById("ee-canvas") as HTMLCanvasElement | null;
    if (!chalkCanvas) return;
    chalkCtx = chalkCanvas.getContext("2d");
    resizeCanvas();
  }
  function resizeCanvas() {
    if (!chalkCanvas) return;
    chalkCanvas.width = window.innerWidth;
    chalkCanvas.height = window.innerHeight;
  }

  function dustAt(x: number, y: number) {
    if (!chalkCtx) return;
    for (let i = 0; i < 6; i++) {
      const a = Math.random() * Math.PI * 2;
      const d = Math.random() * 20 + 2;
      const w = Math.random() * 3.5 + 0.8;
      chalkCtx.save();
      chalkCtx.globalAlpha = Math.random() * 0.35 + 0.04;
      chalkCtx.fillStyle = "white";
      chalkCtx.translate(x + Math.cos(a) * d, y + Math.sin(a) * d);
      chalkCtx.rotate(a);
      chalkCtx.beginPath();
      chalkCtx.ellipse(0, 0, w, w * 0.3, 0, 0, Math.PI * 2);
      chalkCtx.fill();
      chalkCtx.restore();
    }
  }

  function startFade() {
    if (fadeRAF) return;
    function step() {
      if (!chalkCtx || !chalkCanvas) return;
      chalkCtx.globalCompositeOperation = "destination-out";
      chalkCtx.fillStyle = "rgba(0,0,0,0.03)";
      chalkCtx.fillRect(0, 0, chalkCanvas.width, chalkCanvas.height);
      chalkCtx.globalCompositeOperation = "source-over";
      fadeRAF = requestAnimationFrame(step);
    }
    fadeRAF = requestAnimationFrame(step);
  }
  function stopFade() {
    if (fadeRAF) { cancelAnimationFrame(fadeRAF); fadeRAF = null; }
  }

  // ── Idle screensaver ──
  let idleTimer: ReturnType<typeof setTimeout> | null = null;
  let idleShown = false;
  let showGen = 0;

  function chalkType(el: HTMLElement, text: string, gen: number, speed = 42) {
    el.textContent = "";
    let i = 0;
    function step() {
      if (showGen !== gen) return;
      if (i < text.length) {
        el.textContent += text[i++];
        const rect = el.getBoundingClientRect();
        if (rect.width > 0) dustAt(rect.right, rect.top + rect.height * 0.6);
        setTimeout(step, speed + Math.random() * 22);
      }
    }
    step();
  }

  function showIdleScreen() {
    const overlay = document.getElementById("ee-idle");
    const titleEl = document.getElementById("ee-title");
    const textEl  = document.getElementById("ee-text");
    if (!overlay || !titleEl || !textEl) return;

    showGen++;
    const gen = showGen;
    idleShown = true;

    overlay.setAttribute("aria-hidden", "false");
    overlay.classList.add("is-visible");
    if (chalkCanvas) { chalkCanvas.classList.add("is-active"); startFade(); }

    // Title types instantly, body starts after title finishes
    const titleText = titleEl.dataset.eetext ?? "";
    const bodyText  = textEl.dataset.eetext ?? "";
    const titleDuration = titleText.length * 48 + 300;

    chalkType(titleEl, titleText, gen, 48);
    setTimeout(() => chalkType(textEl, bodyText, gen, 38), titleDuration);
  }

  function hideIdleScreen() {
    showGen++;
    idleShown = false;
    const overlay = document.getElementById("ee-idle");
    if (!overlay) return;
    overlay.setAttribute("aria-hidden", "true");
    overlay.classList.remove("is-visible");
    const titleEl = document.getElementById("ee-title");
    const textEl  = document.getElementById("ee-text");
    if (titleEl) titleEl.textContent = "";
    if (textEl)  textEl.textContent  = "";
    if (chalkCanvas) chalkCanvas.classList.remove("is-active");
    stopFade();
    if (chalkCtx && chalkCanvas) chalkCtx.clearRect(0, 0, chalkCanvas.width, chalkCanvas.height);
  }

  function resetIdleTimer() {
    if (idleTimer) clearTimeout(idleTimer);
    if (idleShown) hideIdleScreen();
    idleTimer = setTimeout(showIdleScreen, 20000);
  }

  initChalkCanvas();
  window.addEventListener("resize", resizeCanvas, { passive: true });
  (["mousemove", "keydown", "scroll", "touchstart", "click"] as const).forEach((ev) => {
    window.addEventListener(ev, resetIdleTimer, { passive: true });
  });
  resetIdleTimer();

  document.addEventListener("astro:after-swap", () => {
    kbBuffer = "";
    resetIdleTimer();
  });
</script>
