---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SideTab from "../components/SideTab.astro";
import TuktukProgress from "../components/TuktukProgress.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bean & Barrel — Kávé és Sör",
  description = "Bean & Barrel — tuktuk kávézó és söröző. Rendezvények, franchise, közösség.",
} = Astro.props;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Gothic&family=League+Spartan:wght@700;800&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <SideTab />
    <TuktukProgress />
    <Footer />
  </body>
</html>

<script>
  function initObservers() {
    // chalk underline draw-in
    const chalkEls = document.querySelectorAll<HTMLElement>(".chalk-underline");
    const chalkIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-drawn");
          chalkIO.unobserve(e.target);
        }
      }),
      { threshold: 0.35 },
    );
    chalkEls.forEach((el) => chalkIO.observe(el));

    // section reveal
    const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
    const revealIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.animationDelay =
            (e.target as HTMLElement).dataset.delay ?? "0ms";
          e.target.classList.add("is-visible");
          revealIO.unobserve(e.target);
        }
      }),
      { threshold: 0.15 },
    );
    revealEls.forEach((el) => revealIO.observe(el));
  }

  initObservers();
  document.addEventListener("astro:after-swap", initObservers);
</script>

<style is:global>
  /* ── Page transition: chalk dust ── */
  @keyframes chalk-out {
    from { opacity: 1; filter: blur(0)   brightness(1); }
    to   { opacity: 0; filter: blur(8px) brightness(1.5); }
  }
  @keyframes chalk-in {
    from { opacity: 0; filter: blur(8px) brightness(1.5); }
    to   { opacity: 1; filter: blur(0)   brightness(1); }
  }
  ::view-transition-old(root) {
    animation: 300ms ease-in  forwards chalk-out;
  }
  ::view-transition-new(root) {
    animation: 380ms 180ms ease-out both chalk-in;
  }
</style>
