---
// Ambient chalk dust particles — fixed canvas behind all content
---

<canvas id="chalkBg" aria-hidden="true" role="presentation"></canvas>

<style is:global>
  #chalkBg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  #main {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  if (!document.body.dataset.chalkBgInit) {
    document.body.dataset.chalkBgInit = "1";

    const canvas = document.getElementById("chalkBg") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d")!;

    let W = 0, H = 0;
    const resize = () => {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    interface P {
      x: number; y: number;
      rx: number; ry: number; rot: number;
      alpha: number;
      vx: number; vy: number;
      wobble: number;
      life: number; maxLife: number;
    }

    const spawn = (startY?: number): P => ({
      x:       Math.random() * W,
      y:       startY ?? H + 12,
      rx:      0.7 + Math.random() * 3,
      ry:      0.3 + Math.random() * 1.4,
      rot:     Math.random() * Math.PI,
      alpha:   0.022 + Math.random() * 0.042,
      vx:      (Math.random() - 0.5) * 0.22,
      vy:      -(0.1 + Math.random() * 0.3),
      wobble:  Math.random() * Math.PI * 2,
      life:    0,
      maxLife: 420 + Math.random() * 580,
    });

    const COUNT = 50;
    const particles: P[] = Array.from({ length: COUNT }, () => {
      const p = spawn(Math.random() * H);
      p.life = Math.random() * p.maxLife;
      return p;
    });

    let rafId: number;
    let hidden = false;

    document.addEventListener("visibilitychange", () => {
      hidden = document.hidden;
      if (!hidden) rafId = requestAnimationFrame(tick);
    });

    const tick = () => {
      if (hidden) return;
      ctx.clearRect(0, 0, W, H);

      for (const p of particles) {
        p.life++;
        p.wobble += 0.011;
        p.x += p.vx + Math.sin(p.wobble) * 0.2;
        p.y += p.vy;

        const t = p.life / p.maxLife;
        const fade = t < 0.15 ? t / 0.15 : t > 0.78 ? (1 - t) / 0.22 : 1;

        ctx.save();
        ctx.globalAlpha = p.alpha * fade;
        ctx.fillStyle = "#ffffff";
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.beginPath();
        ctx.ellipse(0, 0, p.rx, p.ry, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        if (p.life >= p.maxLife || p.y < -20) Object.assign(p, spawn());
      }

      rafId = requestAnimationFrame(tick);
    };

    rafId = requestAnimationFrame(tick);
  }
</script>
