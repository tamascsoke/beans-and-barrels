---
// Subtle chalk dust trail — desktop pointer devices only
---

<style is:global>
  .chalk-dot {
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.65);
    filter: blur(1.5px);
    transform: translate(-50%, -50%);
    animation: chalk-dot-fade 1.1s ease-out forwards;
  }
  @keyframes chalk-dot-fade {
    0%   { opacity: 1;   transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0;   transform: translate(-50%, -50%) scale(0.1); }
  }
</style>

<script>
  if (!document.body.dataset.chalkCursorInit && window.matchMedia("(pointer:fine)").matches) {
    document.body.dataset.chalkCursorInit = "1";

    let lastX = 0, lastY = 0, frame = 0;

    document.addEventListener("mousemove", (e) => {
      frame++;
      if (frame % 2 !== 0) return; // every 2nd event

      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      if (dx * dx + dy * dy < 100) return; // min 10px movement

      lastX = e.clientX;
      lastY = e.clientY;

      const dot = document.createElement("div");
      dot.className = "chalk-dot";
      dot.style.left = e.clientX + "px";
      dot.style.top  = e.clientY + "px";

      const w = 5 + Math.random() * 7;
      dot.style.width  = w + "px";
      dot.style.height = (w * (0.5 + Math.random() * 0.4)) + "px";
      dot.style.rotate = ((Math.random() - 0.5) * 60) + "deg";
      dot.style.opacity = (0.35 + Math.random() * 0.35).toString();

      document.body.appendChild(dot);
      setTimeout(() => dot.remove(), 1120);
    });
  }
</script>
