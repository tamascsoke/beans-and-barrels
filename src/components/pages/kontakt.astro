---
import Layout from "../../layouts/Layout.astro";
import { Image } from 'astro:assets';
import ChalkSelect from "../ChalkSelect.astro";
import MiniMap from "../MiniMap.astro";
import tuktukPultImg from '../../assets/uploads/tuktuk-pult.webp';
import { pageContext } from "../../lib/page-context";
import type { TopicKey } from "../../i18n/translations";
import { absoluteUrl } from "../../i18n/locale";
import { PHONE_DISPLAY, PHONE_HREF, EMAIL, FORM_ACTION, getFormSubject, getLocation, hasValidLocation } from "../../lib/contact";
import { contactLocalBusinessSchema } from "../../lib/seo";

const { locale, t, p } = pageContext(Astro.url.pathname);
const topicKeys: TopicKey[] = ["event", "franchise", "press", "other"];
const topics = topicKeys.map((key) => t.common.topics[key]);
const topicValues = topicKeys.map((key) => t.common.topicValues[key]);
const selectedTopicParam = Astro.url.searchParams.get("topic") ?? undefined;
const selectedTopic = selectedTopicParam
  ? topics[topicValues.indexOf(selectedTopicParam)] ?? selectedTopicParam
  : undefined;
const THANK_YOU_URL = absoluteUrl(locale, "/koszonjuk");
const formSubject = getFormSubject(locale);
const location = getLocation(locale);
const title = t.kontakt.metaTitle;
const description = t.kontakt.metaDescription;
const pageSchema = hasValidLocation(locale) ? contactLocalBusinessSchema(description, "/og-image.webp", locale) : undefined;
---

<Layout locale={locale} {title} {description} schema={pageSchema}>
  <section class="section">
    <div class="container contact">
      <div class="contact__copy">
        <span class="h-sub">{t.kontakt.eyebrow}</span>
        <h1 class="h-display"><span class="chalk-underline">{t.kontakt.title}</span></h1>
        <p class="lead">{t.kontakt.lead}</p>
        <ul class="contact__list">
          <li><span class="h-sub">{t.common.phone}</span><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></li>
          <li><span class="h-sub">{t.common.email}</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          {hasValidLocation(locale) && (
            <li>
              <span class="h-sub">{t.common.address}</span>
              <a href={`${p("/kontakt")}#helyszin`}>{location.address}</a>
            </li>
          )}
        </ul>
      </div>

      <div class="photo-frame contact__photo"><Image src={tuktukPultImg} alt={t.kontakt.imageAlt} widths={[400, 700]} sizes="(min-width: 820px) 50vw, 100vw" loading="lazy" /></div>
    </div>
  </section>

  {hasValidLocation(locale) && (
    <section class="section section--alt" id="helyszin">
      <div class="container">
        <MiniMap variant="default" locale={locale} />
      </div>
    </section>
  )}

  <section class="section section--alt section--last" id="urlap">
    <div class="container">
      <h2 class="h-section"><span class="chalk-underline">{t.kontakt.formTitle}</span></h2>
      <form
        class="form"
        action={FORM_ACTION}
        method="POST"
        data-success={t.common.formSuccess}
        data-error={t.common.formError}
      >
        <input type="hidden" name="_subject" value={formSubject} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={THANK_YOU_URL} />
        <input type="text" name="_honey" class="form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <label class="form-field">
          <span class="h-sub">{t.common.name}</span>
          <input type="text" name="name" required />
        </label>
        <label class="form-field">
          <span class="h-sub">{t.common.email}</span>
          <input type="email" name="email" required />
        </label>
        <div class="form-field form__full">
          <span class="h-sub">{t.common.topic}</span>
          <ChalkSelect name="topic" options={topics} label={t.common.topic} value={selectedTopic} />
        </div>
        <label class="form-field form__full">
          <span class="h-sub">{t.common.message}</span>
          <textarea name="message" rows="6" required></textarea>
        </label>

        <label class="form-field form__full form__consent">
          <input type="checkbox" name="gdpr" required />
          <span>
            {t.kontakt.gdprBefore}<a href={p("/adatvedelem")} target="_blank" rel="noopener">{t.kontakt.gdprLink}</a>{t.kontakt.gdprAfter}
          </span>
        </label>

        <button type="submit" class="btn form__submit" id="formSubmit">
          <span class="form__btn-label">{t.common.send}</span>
          <span class="form__btn-loading" aria-hidden="true">{t.common.sending}</span>
        </button>

        <div class="form__feedback" id="formFeedback" aria-live="polite"></div>
      </form>
    </div>
  </section>
</Layout>

<script>
  function initForm() {
    const form     = document.querySelector(".form") as HTMLFormElement | null;
    const btn      = document.getElementById("formSubmit")  as HTMLButtonElement | null;
    const feedback = document.getElementById("formFeedback") as HTMLElement | null;
    if (!form || !btn || !feedback) return;
    if (form.dataset.formInit) return;
    form.dataset.formInit = "1";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      btn.dataset.state = "loading";
      btn.disabled = true;
      feedback.textContent = "";
      feedback.className = "form__feedback";

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (res.ok) {
          btn.dataset.state = "done";
          form.reset();
          feedback.textContent = form.dataset.success ?? "";
          feedback.classList.add("form__feedback--ok");
        } else {
          throw new Error("server");
        }
      } catch {
        btn.dataset.state = "";
        btn.disabled = false;
        feedback.textContent = form.dataset.error ?? "";
        feedback.classList.add("form__feedback--err");
      }
    });
  }

  initForm();
  document.addEventListener("astro:after-swap", initForm);
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
  }
  @media (min-width: 820px) { .contact { grid-template-columns: 1fr 1fr; } }
  .contact__copy { display: grid; gap: 18px; }
  .contact__photo { aspect-ratio: 4 / 3; }
  .contact__list { list-style: none; display: grid; gap: 12px; margin-top: 10px; }
  .contact__list li { display: grid; gap: 2px; }
  .contact__list a:hover { color: var(--accent); }

  .form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 32px;
    max-width: 720px;
  }
  .form__honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  @media (min-width: 640px) { .form { grid-template-columns: 1fr 1fr; } }
  .form__full { grid-column: 1 / -1; }
  .form__submit { grid-column: 1 / -1; justify-self: start; position: relative; }

  .form__btn-loading { display: none; }

  .form__submit[data-state="loading"] .form__btn-label { opacity: 0; }
  .form__submit[data-state="loading"] .form__btn-loading {
    display: block;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
  }
  .form__submit[data-state="loading"] { pointer-events: none; opacity: 0.75; }
  .form__submit[data-state="done"]    { background: #3a8c5a; pointer-events: none; }

  .form__feedback {
    grid-column: 1 / -1;
    font-family: var(--f-body);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    padding: 12px 0;
    display: none;
  }
  .form__feedback--ok  { display: block; color: #7ecfa0; }
  .form__feedback--err { display: block; color: #e07070; }

  /* Chalk-line field */
  .form-field {
    display: grid;
    gap: 6px;
  }
  .form-field input,
  .form-field textarea {
    font-family: var(--f-sub);
    font-weight: 700;
    color: var(--ink);
    background: none;
    border: none;
    border-bottom: 1.5px solid var(--line);
    padding: 12px 0;
    font-size: 16px;
    letter-spacing: 0.06em;
    width: 100%;
    outline: none;
    transition: border-color 200ms, box-shadow 240ms var(--ease);
  }
  @media (min-width: 640px) {
    .form-field input, .form-field textarea { padding: 10px 0; }
  }
  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 6px 18px -10px rgba(240, 138, 28, 0.55);
  }
  .form-field textarea { resize: vertical; }

  .form__consent {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .form__consent input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--line);
    border-radius: 3px;
    margin-top: 3px;
    cursor: pointer;
    position: relative;
    background: transparent;
    transition: border-color 180ms, background 180ms;
    flex-shrink: 0;
  }
  .form__consent input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }
  .form__consent input[type="checkbox"]:checked::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid #1a1a1a;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .form__consent input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .form__consent a {
    color: var(--ink);
    border-bottom: 1px dashed var(--ink-faint);
  }
  .form__consent a:hover { color: var(--accent); border-color: var(--accent); }

  .form-field input:-webkit-autofill,
  .form-field input:-webkit-autofill:hover,
  .form-field input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #2a2929 inset !important;
    box-shadow: 0 0 0 1000px #2a2929 inset !important;
    -webkit-text-fill-color: #f4f4f4 !important;
    caret-color: #f4f4f4;
    transition: background-color 5000s ease-in-out 0s !important;
  }
</style>
