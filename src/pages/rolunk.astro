---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import tuktukCsapatImg from '../assets/uploads/tuktuk-csapat.webp';
import soosBalazsImg from '../assets/uploads/soos-balazs.webp';
import wartaBenedekImg from '../assets/uploads/warta-benedek.webp';
import donatImg from '../assets/uploads/donat.webp';

type Founder = {
  initials: string;
  name: string;
  role: string;
  note: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  photoPosition?: string;
  heroMedia?: boolean;
  compact?: boolean;
};

const founders: Founder[] = [
  {
    initials: "SB",
    name: "Soós Balázs",
    role: "Alapító - menedzsment",
    note: "Én mindig is focista akartam lenni, de nem jött Össze, úgyhogy most itt vagyok.",
    photo: soosBalazsImg,
    photoAlt: "Soós Balázs, a Bean & Barrel alapítója",
    photoPosition: "48% 28%",
    compact: true,
  },
  {
    initials: "WB",
    name: "Warta Benedek",
    role: "Alapító - szakmai háttér",
    note: "Azért nagyobb a képem, mint a többieknek, hogy végre én lehessek a magasabb.",
    photo: wartaBenedekImg,
    photoAlt: "Warta Benedek sört csapol a Bean & Barrel tuktuknál",
    photoPosition: "68% 50%",
    heroMedia: true,
  },
  {
    initials: "VD",
    name: "Váradi Donát",
    role: "Alapító – működtetés",
    note: "Mielőtt csatlakoztam a srácokhoz, energiaitalt ittam reggelente. Most már SÖRözök.",
    photo: donatImg,
    photoAlt: "Váradi Donát, a Bean & Barrel alapítója",
    photoPosition: "50% 7%",
    compact: true,
  },
];
---

<Layout title="Rólunk — Bean & Barrel" description="Ismerd meg a Bean & Barrel alapítóit, történetét és azt, hogyan lett egy kávés-sörös ötletből mozgó tuktuk élmény.">
  <section class="section about-hero">
    <div class="container story">
      <div class="photo-frame story__photo">
        <Image src={tuktukCsapatImg} alt="Bean & Barrel alapítók a tuktuk előtt" widths={[420, 760]} sizes="(min-width: 820px) 48vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="story__aside">
        <div class="story__copy">
          <span class="h-sub">Rólunk</span>
          <h1 class="h-display"><span class="chalk-underline">Történetünk</span></h1>
          <p class="lead">
            Egy fáradt - nekünk még, másnak már korántsem - reggel, a kanapéról lefordulva a hűtőben csak SÖRt, a pulton csak kávét találtunk. A sztorinknak pedig itt indult az a bizonyos első fejezete...
          </p>
        </div>
        <div class="story__cta inline-action">
          <a class="btn" href="/kontakt?topic=Rendezv%C3%A9ny#urlap">Kérd a rendezvényedre</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt section--last">
    <div class="container founders">
      <div class="founders__head stagger">
        <span class="h-sub">Alapítók</span>
        <h2 class="h-display"><span class="chalk-underline">Akik mögötte állnak</span></h2>
      </div>
      <div class="founders__grid stagger">
        {founders.map((founder) => {
          const mediaStyle = founder.photoPosition
            ? `--founder-photo-position: ${founder.photoPosition}`
            : undefined;

          return (
          <article class:list={["founder-card", "panel-motion", founder.heroMedia && "founder-card--hero", founder.compact && "founder-card--compact"]}>
            <div
              class:list={[
                "founder-card__media",
                founder.photo && "founder-card__media--photo",
                founder.heroMedia && "founder-card__media--hero",
              ]}
              style={mediaStyle}
            >
              {founder.photo ? (
                  <Image src={founder.photo} alt={founder.photoAlt ?? founder.name} widths={[320, 520, 720]} sizes="(min-width: 900px) 28vw, 92vw" loading="lazy" />
              ) : (
                <span class="founder-card__initials panel-motion__badge" aria-hidden="true">{founder.initials}</span>
              )}
            </div>
            <div class="founder-card__body">
              <h3 class="h-section founder-card__name">{founder.name}</h3>
              <span class="founder-card__role">{founder.role}</span>
              <p class="body-text founder-card__note">{founder.note}</p>
            </div>
          </article>
          );
        })}
      </div>
      <div class="founders__cta inline-action inline-action--center">
        <a class="btn" href="/kinalat">Nézd meg kínálatunkat!</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero { padding-top: clamp(54px, 8vw, 110px); }
  .story {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(26px, 5vw, 58px);
    align-items: center;
  }
  .story__photo { aspect-ratio: 4 / 3; width: 100%; }
  .story__aside { display: contents; }
  .story__copy { display: grid; gap: 18px; order: 3; }
  .story__cta { order: 2; }
  @media (min-width: 820px) {
    .story { grid-template-columns: 1fr 1fr; }
    .story__aside {
      display: grid;
      gap: 18px;
      align-content: center;
    }
    .story__copy,
    .story__cta { order: unset; }
  }
  .founders { display: grid; gap: clamp(26px, 5vw, 54px); }
  .founders__head { display: grid; gap: 14px; }
  .founders__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    width: 100%;
  }
  @media (min-width: 900px) {
    .founders__grid {
      grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.08fr) minmax(0, 0.98fr);
      column-gap: clamp(20px, 2.6vw, 32px);
      align-items: center;
    }
  }
  .founder-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: start;
    width: 100%;
    gap: 12px;
    padding: clamp(12px, 1.6vw, 16px);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel-bg);
    box-shadow: var(--panel-shadow);
  }
  .founder-card--compact {
    gap: 12px;
  }
  .founder-card--hero {
    gap: 13px;
    padding: clamp(13px, 2.6vw, 17px);
    border-color: rgba(240, 138, 28, 0.34);
    background:
      linear-gradient(145deg, rgba(240, 138, 28, 0.035), rgba(255,255,255,0.015) 48%, rgba(0,0,0,0.05)),
      var(--panel-bg);
  }
  @media (max-width: 639px) {
    .founder-card--compact {
      display: grid;
      grid-template-columns: minmax(126px, 40vw) minmax(0, 1fr);
      align-items: center;
      gap: 16px;
      padding: 13px;
    }
  }
  @media (min-width: 640px) and (max-width: 899px) {
    .founder-card--compact {
      max-width: min(560px, 100%);
      justify-self: center;
    }
    .founder-card--hero {
      max-width: min(620px, 100%);
      justify-self: center;
    }
  }
  @media (min-width: 900px) {
    .founder-card--compact {
      transform: translateY(clamp(8px, 1.5vw, 18px));
    }
    .founder-card--hero {
      align-self: stretch;
      transform: translateY(clamp(22px, 2.4vw, 34px));
    }
  }
  .founder-card__body {
    display: grid;
    gap: 7px;
    align-content: start;
  }
  .founder-card--hero .founder-card__body {
    max-width: 34rem;
  }
  @media (max-width: 899px) {
    .founder-card--hero .founder-card__body {
      justify-self: center;
      width: min(100%, 34rem);
    }
  }
  .founder-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5.15;
    border-radius: 8px;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .founder-card__media:not(.founder-card__media--photo) {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0 12px, transparent 12px 24px),
      linear-gradient(135deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015)),
      var(--bg);
    border: 1px dashed var(--line);
  }
  .founder-card__media--photo {
    border: 1px solid var(--panel-border);
    background: var(--bg);
  }
  .founder-card--hero .founder-card__media--photo {
    width: min(82vw, 300px);
    align-self: center;
    border-color: rgba(240, 138, 28, 0.26);
  }
  .founder-card__media--photo :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .founder-card__media--photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--founder-photo-position, center);
  }
  .founder-card__media--hero {
    aspect-ratio: 3 / 4.05;
  }
  @media (min-width: 900px) {
    .founder-card--hero .founder-card__media--photo {
      width: 100%;
    }
  }
  .founder-card__initials {
    font-family: var(--f-logo);
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .founder-card__name { font-size: clamp(1.22rem, 1.85vw, 1.58rem); }
  .founder-card--hero .founder-card__name {
    font-size: clamp(1.28rem, 1.95vw, 1.68rem);
  }
  .founder-card__role {
    font-family: var(--f-sub);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .founder-card__note {
    margin: 0;
    font-size: clamp(0.84rem, 1vw, 0.94rem);
    line-height: 1.55;
  }
  .founder-card--hero .founder-card__note {
    font-size: clamp(0.86rem, 1.02vw, 0.96rem);
  }
  .founder-card--compact .founder-card__role {
    letter-spacing: 0.2em;
  }
  @media (max-width: 639px) {
    .founder-card--compact .founder-card__name {
      font-size: clamp(1.14rem, 6.4vw, 1.4rem);
    }
    .founder-card--compact .founder-card__role {
      font-size: 0.62rem;
      letter-spacing: 0.17em;
    }
    .founder-card--compact .founder-card__note {
      font-size: 0.82rem;
      line-height: 1.46;
    }
  }
  .founders__cta {
    justify-self: center;
    margin-top: clamp(8px, 2vw, 18px);
  }
</style>
