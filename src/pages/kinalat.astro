---
import Layout from "../layouts/Layout.astro";
import { getCategories } from "../lib/content";

const categories = getCategories();
---

<Layout title="Kínálat — Bean & Barrel">
  <section class="section kinalat-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="h-sub">Kínálat</span>
        <h1 class="h-display"><span class="chalk-underline">Egy tuktuk, négy világ</span></h1>
        <p class="lead">Görgess lefelé — a tuktuk megmutatja, mi mindent hoz magával.</p>
      </div>
      <div class="placeholder-img hero-img">Kép — tuktuk kínálat</div>
    </div>

  </section>

  <section class="section">
    <div class="container categories">
      {
        categories.map((c) => (
          <article class="cat" id={`cat-${c.key}`}>
            <div class="cat__art placeholder-img">Kép — {c.label}</div>
            <div class="cat__copy">
              <span class="h-sub">{c.sub}</span>
              <h2 class="h-section"><span class="chalk-underline">{c.label}</span></h2>
              <ul class="cat__list">
                {c.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .kinalat-hero {
    padding-block: clamp(50px, 8vw, 100px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 40px);
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
  }
  .hero-copy { display: grid; gap: 18px; }
  .hero-img { aspect-ratio: 4 / 3; }

  .categories { display: grid; gap: clamp(40px, 8vw, 90px); }
  .cat {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
  }
  @media (min-width: 820px) {
    .cat { grid-template-columns: 1.1fr 1fr; }
    .cat:nth-child(even) .cat__art { order: 2; }
  }
  .cat__art { aspect-ratio: 4 / 3; width: 100%; }
  .cat__copy { display: grid; gap: 14px; }
  .cat__list {
    list-style: none;
    display: grid;
    gap: 6px;
    font-family: var(--f-body);
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .cat__list li::before {
    content: "—  ";
    color: var(--accent);
  }
</style>
