---
const links = [
  { href: "/", label: "Főoldal" },
  { href: "/rolunk", label: "Rólunk" },
  { href: "/kinalat", label: "Kínálat" },
  { href: "/rendezvenyek", label: "Rendezvények" },
  { href: "/franchise", label: "Franchise" },
  { href: "/kontakt", label: "Kontakt" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!-- drawer is a sibling of header to avoid backdrop-filter containing-block bug -->
<header class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label="Bean & Barrel főoldal">
      <img src="/logo.png" alt="Bean & Barrel" />
    </a>
    <a href="/" class="nav__brand">BEAN &amp; BARREL</a>
    <button
      class="nav__toggle"
      aria-controls="nav-drawer"
      aria-expanded="false"
      aria-label="Menü megnyitása"
      id="navToggle"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<nav id="nav-drawer" class="nav__drawer" aria-hidden="true">
  <ul>
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={["nav__link", { "is-active": path === l.href }]}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* backdrop-filter lives on ::before so it doesn't create a containing-block
     for the fixed-positioned drawer (CSS spec §9.3.1 / Chrome behaviour) */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
  }
  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(54, 53, 53, 0.92);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    z-index: -1;
  }

  .nav__inner {
    height: var(--nav-h);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
  }

  /* Logo: show at natural aspect ratio, no clipping */
  .nav__logo {
    display: inline-flex;
    align-items: center;
    height: calc(var(--nav-h) - 24px);
    flex-shrink: 0;
  }
  .nav__logo img {
    height: 100%;
    width: auto;
    border-radius: 8px;
  }

  .nav__brand {
    font-family: var(--f-logo);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    line-height: 1;
  }

  .nav__toggle {
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .nav__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    transition: transform 200ms var(--ease), opacity 200ms var(--ease);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer is outside <header> so backdrop-filter doesn't trap it */
  .nav__drawer {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    background-image:
      radial-gradient(circle at 20% 15%, rgba(255,255,255,0.04), transparent 60%),
      radial-gradient(circle at 85% 80%, rgba(255,255,255,0.03), transparent 55%);
    transform: translateY(-16px);
    opacity: 0;
    pointer-events: none;
    transition: transform 260ms var(--ease), opacity 260ms var(--ease);
    z-index: 48;
    overflow-y: auto;
  }
  .nav__drawer[aria-hidden="false"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav__drawer ul {
    list-style: none;
    padding: clamp(40px, 8vw, 80px) var(--gutter);
    display: grid;
    gap: 14px;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .nav__link {
    font-family: var(--f-logo);
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: inline-block;
    transition: color 150ms var(--ease);
  }
  .nav__link.is-active { color: var(--accent); }
  .nav__link:hover    { color: var(--accent); }
</style>

<script>
  const btn    = document.getElementById("navToggle") as HTMLButtonElement | null;
  const drawer = document.getElementById("nav-drawer") as HTMLElement | null;
  if (btn && drawer) {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      drawer.setAttribute("aria-hidden", String(open));
      document.body.style.overflow = open ? "" : "hidden";
    });
    drawer.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        btn.setAttribute("aria-expanded", "false");
        drawer.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }),
    );
  }
</script>
