---
import { getCarouselSlides } from "../lib/content";
const slides = getCarouselSlides();
---

<section class="carousel" aria-roledescription="carousel">
  <div class="carousel__track" id="carouselTrack">
    {
      slides.map((s, i) => (
        <article class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`}>
          {s.image
            ? <img class="carousel__art" src={s.image} alt={s.imageAlt ?? s.eyebrow} decoding="async" />
            : <div class="carousel__art placeholder-img">{`Kép — ${s.eyebrow.toUpperCase()}`}</div>
          }
          <div class="carousel__copy stagger">
            <span class="h-sub">{s.eyebrow}</span>
            <h2 class="h-display"><span class="chalk-underline">{s.title}</span></h2>
            <p class="lead">{s.body}</p>
            <a class="btn" href={s.ctaHref}>{s.ctaLabel}</a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="carousel__dots" role="tablist">
    {slides.map((_, i) => (
      <button class="carousel__dot" data-i={i} aria-label={`${i + 1}. dia`}></button>
    ))}
  </div>
</section>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel__track {
    display: flex;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    padding-inline: var(--gutter);
    padding-block: clamp(40px, 7vw, 80px);
    max-width: var(--max-w);
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 860px) {
    .carousel__slide {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .carousel__art {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: var(--r-md);
    object-fit: cover;
    display: block;
    box-shadow: 3px 6px 22px rgba(0,0,0,0.55);
    outline: 5px solid rgba(244,244,244,0.05);
  }

  .carousel__copy {
    display: grid;
    gap: 18px;
    align-content: center;
  }
  .carousel__copy .btn {
    justify-self: start;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding-bottom: 22px;
  }
  .carousel__dot {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .carousel__dot::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-faint);
    transition: background 200ms var(--ease), transform 200ms var(--ease);
  }
  .carousel__dot.is-active::before {
    background: var(--accent);
    transform: scale(1.3);
  }
</style>

<script>
  function initCarousel() {
    const track = document.getElementById("carouselTrack") as HTMLElement | null;
    const dots  = Array.from(document.querySelectorAll(".carousel__dot")) as HTMLButtonElement[];
    if (!track || !dots.length) return;

    const slides = Array.from(track.children) as HTMLElement[];
    let timer: ReturnType<typeof setInterval> | null = null;

    const getActive = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0, bestDist = Infinity;
      slides.forEach((s, i) => {
        const dist = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
        if (dist < bestDist) { bestDist = dist; best = i; }
      });
      return best;
    };

    const setActive = () => {
      const i = getActive();
      dots.forEach((d, idx) => d.classList.toggle("is-active", idx === i));
    };

    const goTo = (i: number) =>
      track.scrollTo({ left: slides[i].offsetLeft, behavior: "smooth" });

    const next = () => goTo((getActive() + 1) % slides.length);

    const startAuto = () => { stopAuto(); timer = setInterval(next, 4500); };
    const stopAuto  = () => { if (timer) { clearInterval(timer); timer = null; } };

    track.addEventListener("scroll", () => requestAnimationFrame(setActive), { passive: true });
    dots.forEach((d, i) => d.addEventListener("click", () => { goTo(i); startAuto(); }));
    track.addEventListener("mouseenter", stopAuto);
    track.addEventListener("mouseleave", startAuto);
    track.addEventListener("touchstart", stopAuto,  { passive: true });
    track.addEventListener("touchend",   startAuto, { passive: true });

    setActive();
    startAuto();
  }

  initCarousel();
  document.addEventListener("astro:after-swap", initCarousel);
</script>
