---
import { Image, getImage } from 'astro:assets';
import { getGalleryPhotos, resolveImage } from "../lib/content";

const photos    = getGalleryPhotos().slice(0, 10);
const hasPhotos = photos.length > 0;
const items     = hasPhotos ? photos : Array.from({ length: 6 }, (_, i) => ({ image: "", alt: `Kép ${i + 1}` }));
const sets      = hasPhotos ? (photos.length < 5 ? 3 : 2) : 2;

const enriched = await Promise.all(items.map(async (p) => {
  const asset = resolveImage(p.image);
  const fullSrc = asset
    ? (await getImage({ src: asset, width: 1400, format: 'webp' })).src
    : p.image;
  return { ...p, asset, fullSrc };
}));
---

<section class="gallery-section section section--last">
  <div class="container gallery-head stagger">
    <span class="h-sub">Képgaléria</span>
    <h2 class="h-display"><span class="chalk-underline">Pillanatok</span></h2>
  </div>

  <div class="gallery-wrap" id="galleryWrap" aria-label="Fotógaléria" data-sets={sets}>
    <div class="gallery-inner" id="galleryInner">
      {Array.from({ length: sets }, () => enriched).flat().map((p) => (
        <button class={`gallery-frame${!hasPhotos ? " gallery-frame--ph" : ""}`} type="button" data-src={p.fullSrc} data-alt={p.alt} aria-label={p.alt} disabled={!hasPhotos}>
          {hasPhotos && p.asset
            ? <Image src={p.asset} alt={p.alt} width={360} loading="lazy" draggable="false" />
            : hasPhotos
              ? <img src={p.image} alt={p.alt} decoding="async" draggable="false" />
              : <span>{p.alt}</span>
          }
        </button>
      ))}
    </div>
    <button class="gallery-nav gallery-nav--prev" type="button" aria-label="Előző képek"><span aria-hidden="true">‹</span></button>
    <button class="gallery-nav gallery-nav--next" type="button" aria-label="Következő képek"><span aria-hidden="true">›</span></button>
  </div>

  <div class="gallery-lightbox" id="stripLightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Képnéző" inert>
    <button class="gallery-lightbox__close" id="stripLbClose" type="button" aria-label="Bezárás">✕</button>
    <button class="gallery-lightbox__prev" id="stripLbPrev" type="button" aria-label="Előző">‹</button>
    <button class="gallery-lightbox__next" id="stripLbNext" type="button" aria-label="Következő">›</button>
    <figure class="gallery-lightbox__fig">
      <img id="stripLbImg" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" />
      <figcaption id="stripLbCaption" class="gallery-lightbox__caption"></figcaption>
    </figure>
  </div>

  <div class="container gallery-cta">
    <div class="inline-action inline-action--center">
      <a class="btn btn--ghost" href="/galeria">Galéria</a>
    </div>
  </div>
</section>

<style>
  .gallery-head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .gallery-frame--ph {
    background-image:
      linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02)),
      repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0 12px, transparent 12px 24px);
    border: 1px dashed var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    font-size: 0.85rem;
    letter-spacing: clamp(0.16em, 0.8vw, 0.3em);
    text-transform: uppercase;
  }

  .gallery-frame--ph span { pointer-events: none; }

  .gallery-wrap {
    position: relative;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    touch-action: pan-x pan-y;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 32px,
      black calc(100% - 32px),
      transparent 100%
    );
  }
  @media (min-width: 640px) {
    .gallery-wrap {
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 72px,
        black calc(100% - 72px),
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 72px,
        black calc(100% - 72px),
        transparent 100%
      );
    }
  }

  .gallery-wrap:active { cursor: grabbing; }

  .gallery-inner {
    display: flex;
    gap: 14px;
    padding-block: 8px;
    width: max-content;
    will-change: transform;
  }

  .gallery-frame {
    height: clamp(140px, 34vw, 340px);
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--bg-2);
    border: 1px solid var(--panel-border);
    box-shadow: var(--panel-shadow);
    color: inherit;
    padding: 0;
    cursor: pointer;
  }
  .gallery-frame:disabled { cursor: default; }

  @media (min-width: 900px) {
    .gallery-frame { height: clamp(130px, 24vw, 256px); }
  }

  .gallery-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: transform 600ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery-wrap:hover .gallery-frame img { transform: scale(1.03); }
  }

  .gallery-nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(42,41,41,0.58);
    opacity: 0.88;
    transform: translateY(-50%);
    transition: opacity 220ms var(--ease), background 220ms var(--ease);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .gallery-nav--prev { left: 12px; }
  .gallery-nav--next { right: 12px; }
  .gallery-nav span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(244,244,244,0.28);
    border-radius: 999px;
    font-size: 2.4rem;
    line-height: 1;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 900px) {
    .gallery-nav {
      top: 0;
      bottom: 0;
      height: auto;
      align-items: center;
      width: 24%;
      opacity: 0;
      border-radius: 0;
      background: transparent;
      transform: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: opacity 220ms var(--ease), background 220ms var(--ease);
    }
    .gallery-nav:hover,
    .gallery-nav:focus-visible {
      opacity: 1;
      background: linear-gradient(90deg, rgba(0,0,0,0.22), transparent);
    }
    .gallery-nav--prev {
      left: 0;
      justify-items: start;
      padding-left: var(--gutter);
    }
    .gallery-nav--next {
      right: 0;
      justify-items: end;
      padding-right: var(--gutter);
    }
    .gallery-nav--next:hover,
    .gallery-nav--next:focus-visible {
      background: linear-gradient(270deg, rgba(0,0,0,0.22), transparent);
    }
    .gallery-nav span {
      width: 52px;
      height: 52px;
      background: rgba(42,41,41,0.46);
      font-size: 3rem;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 220;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgba(0, 0, 0, 0.93);
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .gallery-lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }
  .gallery-lightbox__fig {
    display: grid;
    gap: 12px;
    max-width: min(92vw, 1280px);
    max-height: 92vh;
    place-items: center;
  }
  .gallery-lightbox__fig img {
    max-width: 100%;
    max-height: 84vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-md);
    display: block;
    box-shadow: 0 24px 80px rgba(0,0,0,0.7);
  }
  .gallery-lightbox__caption {
    font-family: var(--f-body);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: center;
  }
  .gallery-lightbox__close,
  .gallery-lightbox__prev,
  .gallery-lightbox__next {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.08);
    border-radius: 50%;
    transition: background 180ms var(--ease), transform 180ms var(--ease);
  }
  .gallery-lightbox__close:hover,
  .gallery-lightbox__prev:hover,
  .gallery-lightbox__next:hover {
    background: rgba(255,255,255,0.16);
    transform: scale(1.08);
  }
  .gallery-lightbox__close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
  }
  .gallery-lightbox__prev,
  .gallery-lightbox__next {
    top: 50%;
    translate: 0 -50%;
    width: 52px;
    height: 52px;
    font-size: 1.8rem;
    line-height: 1;
  }
  .gallery-lightbox__prev { left: 16px; }
  .gallery-lightbox__next { right: 16px; }
  .gallery-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(18px, 3vw, 30px);
  }
</style>

<script>
  import { getFocusable, setInert, trapFocus } from "../lib/overlay-a11y";

  let galleryAbort: AbortController | null = null;

  function initGallery() {
    galleryAbort?.abort();
    galleryAbort = new AbortController();
    const { signal } = galleryAbort;

    const wrap  = document.getElementById("galleryWrap")  as HTMLElement | null;
    const inner = document.getElementById("galleryInner") as HTMLElement | null;
    if (!wrap || !inner) return;
    const prev = wrap.querySelector<HTMLButtonElement>(".gallery-nav--prev");
    const next = wrap.querySelector<HTMLButtonElement>(".gallery-nav--next");
    const lightbox = document.getElementById("stripLightbox");
    const lbImg = document.getElementById("stripLbImg") as HTMLImageElement | null;
    const lbCaption = document.getElementById("stripLbCaption");
    const lbClose = document.getElementById("stripLbClose");
    const lbPrev = document.getElementById("stripLbPrev");
    const lbNext = document.getElementById("stripLbNext");

    const seenSrc = new Set<string>();
    const lbFrames = Array.from(inner.querySelectorAll<HTMLElement>(".gallery-frame[data-src]:not([disabled])"))
      .filter((f) => {
        const src = f.dataset.src ?? "";
        if (!src || seenSrc.has(src)) return false;
        seenSrc.add(src);
        return true;
      });

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const SPEED = reduceMotion ? 0 : 0.55;
    const DRAG_THRESHOLD = 8;
    let pos        = 0;
    let isDragging = false;
    let activePointer: number | null = null;
    let dragStartX = 0;
    let dragStartPos = 0;
    let suppressClick = false;
    let halfW      = 0;
    let rafId: number | null = null;
    let isVisible = false;
    let isReady = false;

    function wrapPos(value: number) {
      if (halfW <= 0) return value;
      let next = value;
      while (next < 0) next += halfW;
      while (next >= halfW) next -= halfW;
      return next;
    }

    function applyTransform() {
      inner!.style.transform = `translate3d(${-pos}px, 0, 0)`;
    }

    function remeasure() {
      const sets = parseInt(wrap!.dataset.sets ?? "2", 10);
      const nextHalf = inner!.scrollWidth / sets;
      if (!Number.isFinite(nextHalf) || nextHalf <= 0) return false;
      halfW = nextHalf;
      pos = wrapPos(pos);
      isReady = true;
      applyTransform();
      return true;
    }

    function tick() {
      if (!isVisible && !isDragging) {
        rafId = null;
        return;
      }
      if (!isDragging && SPEED > 0) {
        pos = wrapPos(pos + SPEED);
      }
      applyTransform();
      rafId = requestAnimationFrame(tick);
    }

    function startLoop() {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(tick);
    }

    function stopAnimation() {
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null;
    }

    function tryStart() {
      if (!remeasure()) return;
      if (isVisible || isDragging) startLoop();
    }

    const visibilityIO = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      if (isVisible && isReady) startLoop();
      if (!isVisible && !isDragging) stopAnimation();
    }, { threshold: 0.08 });
    visibilityIO.observe(wrap);

    const resizeIO = new ResizeObserver(() => {
      remeasure();
      if (isVisible || isDragging) startLoop();
    });
    resizeIO.observe(inner);
    signal.addEventListener("abort", () => resizeIO.disconnect(), { once: true });

    const imgs = Array.from(inner.querySelectorAll("img")) as HTMLImageElement[];
    const onImgReady = () => tryStart();
    imgs.forEach((img) => {
      if (img.complete) return;
      img.addEventListener("load", onImgReady, { once: true, signal });
      img.addEventListener("error", onImgReady, { once: true, signal });
    });

    if (document.fonts?.ready) {
      document.fonts.ready.then(() => tryStart()).catch(() => undefined);
    }
    tryStart();
    window.requestAnimationFrame(() => tryStart());

    function endPointer(e: PointerEvent) {
      if (activePointer !== e.pointerId) return;
      if (isDragging) {
        wrap.releasePointerCapture(e.pointerId);
        wrap.style.cursor = "";
      }
      isDragging = false;
      activePointer = null;
    }

    wrap.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest(".gallery-nav")) return;
      activePointer = e.pointerId;
      isDragging = false;
      suppressClick = false;
      dragStartX = e.clientX;
      dragStartPos = pos;
    }, { signal });

    wrap.addEventListener("pointermove", (e) => {
      if (activePointer !== e.pointerId) return;
      const dx = dragStartX - e.clientX;
      if (!isDragging) {
        if (Math.abs(dx) <= DRAG_THRESHOLD) return;
        isDragging = true;
        suppressClick = true;
        wrap.setPointerCapture(e.pointerId);
        wrap.style.cursor = "grabbing";
      }
      pos = wrapPos(dragStartPos + dx);
      applyTransform();
      if (rafId === null) startLoop();
    }, { signal });

    wrap.addEventListener("pointerup", endPointer, { signal });
    wrap.addEventListener("pointercancel", endPointer, { signal });

    function shift(dir: 1 | -1) {
      pos = wrapPos(pos + dir * wrap!.clientWidth * 0.72);
      applyTransform();
      if (rafId === null) startLoop();
    }

    let releaseLbTrap: (() => void) | null = null;
    let lbLastFocus: HTMLElement | null = null;
    let lbCurrent = 0;

    function show(idx: number) {
      if (!lightbox || !lbImg || lbFrames.length === 0) return;
      lbCurrent = ((idx % lbFrames.length) + lbFrames.length) % lbFrames.length;
      const frame = lbFrames[lbCurrent];
      const src = frame.dataset.src ?? "";
      const alt = frame.dataset.alt ?? "";
      if (!src) return;
      if (lightbox.getAttribute("aria-hidden") === "true") {
        lbLastFocus = document.activeElement as HTMLElement | null;
      }
      lbImg.src = src;
      lbImg.alt = alt;
      if (lbCaption) lbCaption.textContent = alt;
      lightbox.setAttribute("aria-hidden", "false");
      setInert(lightbox, false);
      document.body.classList.add("has-lightbox-open");
      document.body.style.overflow = "hidden";
      releaseLbTrap?.();
      releaseLbTrap = trapFocus(lightbox);
      getFocusable(lightbox)[0]?.focus();
    }

    function hide() {
      if (!lightbox) return;
      lightbox.setAttribute("aria-hidden", "true");
      setInert(lightbox, true);
      document.body.classList.remove("has-lightbox-open");
      document.body.style.overflow = "";
      releaseLbTrap?.();
      releaseLbTrap = null;
      lbLastFocus?.focus();
      lbLastFocus = null;
    }

    function openFrame(frame: HTMLElement) {
      const idx = lbFrames.findIndex((f) => f.dataset.src === frame.dataset.src);
      if (idx >= 0) show(idx);
    }

    prev?.addEventListener("click", (e) => { e.stopPropagation(); shift(-1); }, { signal });
    next?.addEventListener("click", (e) => { e.stopPropagation(); shift(1); }, { signal });

    inner.querySelectorAll<HTMLElement>(".gallery-frame[data-src]:not([disabled])").forEach((frame) => {
      frame.addEventListener("click", (e) => {
        if (suppressClick) {
          suppressClick = false;
          e.preventDefault();
          return;
        }
        e.stopPropagation();
        openFrame(frame);
      }, { signal });
      frame.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openFrame(frame);
        }
      }, { signal });
    });

    lbClose?.addEventListener("click", hide, { signal });
    lbPrev?.addEventListener("click", () => show(lbCurrent - 1), { signal });
    lbNext?.addEventListener("click", () => show(lbCurrent + 1), { signal });
    lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) hide(); }, { signal });
    document.addEventListener("keydown", (e) => {
      if (lightbox?.getAttribute("aria-hidden") !== "false") return;
      if (e.key === "Escape") hide();
      if (e.key === "ArrowLeft") show(lbCurrent - 1);
      if (e.key === "ArrowRight") show(lbCurrent + 1);
    }, { signal });

    document.addEventListener("astro:before-swap", () => {
      stopAnimation();
      visibilityIO.disconnect();
      resizeIO.disconnect();
      hide();
      galleryAbort?.abort();
    }, { once: true, signal });
  }

  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>
