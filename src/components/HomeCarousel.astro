---
import { Image } from 'astro:assets';
import { getCarouselSlides, resolveImage } from "../lib/content";
const slides = getCarouselSlides();
---

<section class="carousel" aria-roledescription="carousel">
  <div class="carousel__track" id="carouselTrack">
    {
      slides.map((s, i) => (
        <article class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`}>
          {s.image && resolveImage(s.image)
            ? <div class="photo-frame carousel__art">
                <Image src={resolveImage(s.image)!} alt={s.imageAlt ?? s.eyebrow}
                       widths={[400, 700]} sizes="(min-width: 860px) 50vw, 100vw"
                       loading={i === 0 ? "eager" : "lazy"}
                       fetchpriority={i === 0 ? "high" : "auto"} />
              </div>
            : <div class="carousel__art placeholder-img">{`Kép — ${s.eyebrow.toUpperCase()}`}</div>
          }
          <div class="carousel__copy stagger">
            <span class="h-sub">{s.eyebrow}</span>
            <h2 class="h-display"><span class="chalk-underline">{s.title}</span></h2>
            <p class="lead carousel__lead">{s.body}</p>
          </div>
          <div class="carousel__cta inline-action">
            <a class="btn" href={s.ctaHref}>{s.ctaLabel}</a>
          </div>
        </article>
      ))
    }
  </div>

  <button class="carousel__nav carousel__nav--prev" type="button" aria-label="Előző dia">
    <span aria-hidden="true">‹</span>
  </button>
  <button class="carousel__nav carousel__nav--next" type="button" aria-label="Következő dia">
    <span aria-hidden="true">›</span>
  </button>

  <div class="carousel__dots" role="tablist">
    {slides.map((_, i) => (
      <button class="carousel__dot" data-i={i} aria-label={`${i + 1}. dia`}></button>
    ))}
  </div>
</section>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel__track {
    display: flex;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "art"
      "copy"
      "cta";
    gap: clamp(20px, 4vw, 40px);
    padding-inline: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
    padding-block: clamp(24px, 3.5vw, 44px);
    width: 100%;
    max-width: none;
    align-items: start;
  }

  @media (min-width: 860px) {
    .carousel__slide {
      grid-template-columns: 1.1fr 1fr;
      grid-template-areas:
        "art copy"
        "art cta";
      align-items: start;
    }
  }

  .carousel__art {
    grid-area: art;
    width: 100%;
    max-width: 620px;
    justify-self: center;
    aspect-ratio: 4 / 3;
    height: auto;
    transform: none;
    outline: 0;
    box-shadow: var(--photo-shadow);
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--bg-2);
  }
  .carousel__art::before,
  .carousel__art::after { content: none; }
  .carousel__art img { border-radius: var(--r-md); }

  .carousel__copy {
    grid-area: copy;
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .carousel__lead {
    text-transform: none;
  }

  .carousel__cta {
    grid-area: cta;
    margin-top: 0;
  }

  @media (min-width: 860px) {
    .carousel__art {
      grid-row: 1 / -1;
      align-self: start;
    }

    .carousel__copy .h-display {
      min-height: 2.5em;
    }

    .carousel__copy .lead {
      min-height: calc(1.55em * 3);
    }

    .carousel__cta {
      align-self: start;
    }
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding-bottom: 22px;
  }
  .carousel__dot {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .carousel__dot::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-faint);
    transition: background 200ms var(--ease), transform 200ms var(--ease);
  }
  .carousel__dot.is-active::before {
    background: var(--accent);
    transform: scale(1.3);
  }

  .carousel__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: rgba(42,41,41,0.58);
    opacity: 0.88;
    transform: translateY(-50%);
    transition: opacity 220ms var(--ease), background 220ms var(--ease);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .carousel__nav--prev { left: 12px; }
  .carousel__nav--next { right: 12px; }
  .carousel__nav span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(244,244,244,0.26);
    border-radius: 999px;
    font-size: 2.9rem;
    line-height: 1;
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 860px) {
    .carousel__nav {
      top: 0;
      bottom: 54px;
      height: auto;
      align-items: center;
      width: 30%;
      opacity: 0;
      border-radius: 0;
      background: transparent;
      transform: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: opacity 220ms var(--ease), background 220ms var(--ease);
    }
    .carousel__nav:hover,
    .carousel__nav:focus-visible {
      opacity: 1;
      background: linear-gradient(90deg, rgba(0,0,0,0.2), transparent);
    }
    .carousel__nav--prev {
      left: 0;
      justify-items: start;
      padding-left: var(--gutter);
    }
    .carousel__nav--next {
      right: 0;
      justify-items: end;
      padding-right: var(--gutter);
    }
    .carousel__nav--next:hover,
    .carousel__nav--next:focus-visible {
      background: linear-gradient(270deg, rgba(0,0,0,0.2), transparent);
    }
    .carousel__nav span {
      width: 66px;
      height: 66px;
      background: rgba(42,41,41,0.44);
      font-size: 3.6rem;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  }
</style>

<script>
  function initCarousel() {
    const track = document.getElementById("carouselTrack") as HTMLElement | null;
    const dots  = Array.from(document.querySelectorAll(".carousel__dot")) as HTMLButtonElement[];
    const prev  = document.querySelector<HTMLButtonElement>(".carousel__nav--prev");
    const nextBtn = document.querySelector<HTMLButtonElement>(".carousel__nav--next");
    if (!track || !dots.length) return;

    const slides = Array.from(track.children) as HTMLElement[];
    let timer: ReturnType<typeof setInterval> | null = null;

    const getActive = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0, bestDist = Infinity;
      slides.forEach((s, i) => {
        const dist = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
        if (dist < bestDist) { bestDist = dist; best = i; }
      });
      return best;
    };

    const setActive = () => {
      const i = getActive();
      dots.forEach((d, idx) => d.classList.toggle("is-active", idx === i));
    };

    const goTo = (i: number) =>
      track.scrollTo({ left: slides[i].offsetLeft, behavior: "smooth" });

    const next = () => goTo((getActive() + 1) % slides.length);
    const prevSlide = () => goTo((getActive() - 1 + slides.length) % slides.length);

    const startAuto = () => { stopAuto(); timer = setInterval(next, 6500); };
    const stopAuto  = () => { if (timer) { clearInterval(timer); timer = null; } };

    track.addEventListener("scroll", () => requestAnimationFrame(setActive), { passive: true });
    dots.forEach((d, i) => d.addEventListener("click", () => { goTo(i); startAuto(); }));
    prev?.addEventListener("click", () => { prevSlide(); startAuto(); });
    nextBtn?.addEventListener("click", () => { next(); startAuto(); });
    track.addEventListener("mouseenter", stopAuto);
    track.addEventListener("mouseleave", startAuto);
    track.addEventListener("touchstart", stopAuto,  { passive: true });
    track.addEventListener("touchend",   startAuto, { passive: true });

    setActive();
    startAuto();
  }

  initCarousel();
  document.addEventListener("astro:after-swap", initCarousel);
</script>
