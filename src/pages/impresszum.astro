---
import Layout from "../layouts/Layout.astro";
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from "../lib/contact";
---

<Layout title="Impresszum — Bean & Barrel" description="Bean & Barrel — Impresszum, üzemeltetői és tárhelyszolgáltatói adatok.">
  <section class="section section--last">
    <div class="container legal">
      <span class="h-sub">Jogi</span>
      <h1 class="h-display"><span class="chalk-underline">Impresszum</span></h1>

      <div class="legal__body body-text">
        <h2 class="h-section">Szolgáltató (üzemeltető)</h2>
        <dl class="legal__list">
          <dt>Cégnév</dt>            <dd>Bean &amp; Barrel - üzemeltetői adatok egyeztetés alatt</dd>
          <dt>Székhely</dt>          <dd>Egyeztetés alatt</dd>
          <dt>Adószám</dt>           <dd>Egyeztetés alatt</dd>
          <dt>Cégjegyzékszám</dt>    <dd>Egyeztetés alatt</dd>
          <dt>Képviselő</dt>         <dd>Egyeztetés alatt</dd>
          <dt>E-mail</dt>            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          <dt>Telefon</dt>           <dd><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></dd>
        </dl>

        <h2 class="h-section">Tárhelyszolgáltató</h2>
        <dl class="legal__list">
          <dt>Név</dt>     <dd>Vercel Inc.</dd>
          <dt>Cím</dt>     <dd>340 S Lemon Ave #4133, Walnut, CA 91789, USA</dd>
          <dt>E-mail</dt>  <dd><a href="mailto:privacy@vercel.com">privacy@vercel.com</a></dd>
          <dt>Weboldal</dt><dd><a href="https://vercel.com" target="_blank" rel="noopener">vercel.com</a></dd>
        </dl>

        <h2 class="h-section">Szerzői jogok</h2>
        <p>
          A weboldalon közzétett tartalmak (szövegek, képek, grafikai elemek, márkanév és logó)
          a Bean &amp; Barrel szellemi tulajdonát képezik. Felhasználásuk — másolás, terjesztés,
          módosítás — kizárólag az üzemeltető előzetes, írásbeli engedélyével lehetséges.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal { max-width: 820px; display: grid; gap: 18px; }
  .legal__body { display: grid; gap: 28px; margin-top: 24px; }
  .legal__body h2 { font-size: clamp(1.2rem, 2vw, 1.5rem); margin-top: 8px; }
  .legal__body p { line-height: 1.7; }

  .legal__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 24px;
    margin-top: 10px;
  }
  .legal__list dt {
    font-family: var(--f-sub);
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
    padding-top: 3px;
  }
  .legal__list dd { color: var(--ink); line-height: 1.6; }
  .legal__list a:hover { color: var(--accent); }

  @media (max-width: 560px) {
    .legal__list { grid-template-columns: 1fr; gap: 4px 0; }
    .legal__list dd { margin-bottom: 14px; }
  }
</style>
