---
import Layout from "../../layouts/Layout.astro";
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from "../../lib/contact";
import { pageContext } from "../../lib/page-context";

const { locale, t } = pageContext(Astro.url.pathname);
const v = t.impresszum;
---

<Layout locale={locale} title={v.metaTitle} description={v.metaDescription}>
  <section class="section section--last">
    <div class="container legal">
      <span class="h-sub">{v.eyebrow}</span>
      <h1 class="h-display"><span class="chalk-underline">{v.title}</span></h1>

      <div class="legal__body body-text">
        <h2 class="h-section">{v.providerHeading}</h2>
        <dl class="legal__list">
          <dt>{v.labels.company}</dt>            <dd>{v.providerValues.company}</dd>
          <dt>{v.labels.seat}</dt>          <dd>{v.providerValues.seat}</dd>
          <dt>{v.labels.tax}</dt>           <dd>{v.providerValues.tax}</dd>
          <dt>{v.labels.reg}</dt>    <dd>{v.providerValues.reg}</dd>
          <dt>{v.labels.rep}</dt>         <dd>{v.providerValues.rep}</dd>
          <dt>{v.labels.email}</dt>            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          <dt>{v.labels.phone}</dt>           <dd><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></dd>
        </dl>

        <h2 class="h-section">{v.hosting}</h2>
        <dl class="legal__list">
          <dt>{v.labels.name}</dt>     <dd>{v.hostingValues.name}</dd>
          <dt>{v.labels.address}</dt>     <dd>{v.hostingValues.address}</dd>
          <dt>{v.labels.email}</dt>  <dd><a href={`mailto:${v.hostingValues.email}`}>{v.hostingValues.email}</a></dd>
          <dt>{v.labels.website}</dt><dd><a href={v.hostingValues.website} target="_blank" rel="noopener">vercel.com</a></dd>
        </dl>

        <h2 class="h-section">{v.copyrightHeading}</h2>
        <p>{v.copyright}</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal { max-width: 820px; display: grid; gap: 18px; }
  .legal__body { display: grid; gap: 28px; margin-top: 24px; }
  .legal__body h2 { font-size: clamp(1.2rem, 2vw, 1.5rem); margin-top: 8px; }
  .legal__body p { line-height: 1.7; }

  .legal__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 24px;
    margin-top: 10px;
  }
  .legal__list dt {
    font-family: var(--f-sub);
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
    padding-top: 3px;
  }
  .legal__list dd { color: var(--ink); line-height: 1.6; }
  .legal__list a:hover { color: var(--accent); }

  @media (max-width: 560px) {
    .legal__list { grid-template-columns: 1fr; gap: 4px 0; }
    .legal__list dd { margin-bottom: 14px; }
  }
</style>
