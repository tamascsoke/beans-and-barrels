---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SideTab from "../components/SideTab.astro";
import ChalkCursor from "../components/ChalkCursor.astro";
import ScrollExtras from "../components/ScrollExtras.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bean & Barrel — Kávé és Sör",
  description = "Bean & Barrel — tuktuk kávézó és söröző. Rendezvények, franchise, közösség.",
} = Astro.props;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Gothic&family=League+Spartan:wght@700;800&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <SideTab />
    <ScrollExtras />
    <ChalkCursor />
    <Footer />
  </body>
</html>

<script>
  /* ── Global one-time inits (survive page swaps via astro:after-swap) ── */

  // Parallax — single global listener, queries [data-parallax] each frame
  if (!document.body.dataset.parallaxInit && window.matchMedia("(pointer:fine)").matches) {
    document.body.dataset.parallaxInit = "1";
    let ticking = false;
    document.addEventListener("mousemove", (e) => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const xPct = e.clientX / window.innerWidth  - 0.5;
        const yPct = e.clientY / window.innerHeight - 0.5;
        document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
          const d = parseFloat(el.dataset.parallax ?? "1");
          el.style.transform = `translate(${xPct * d * -22}px, ${yPct * d * -10}px)`;
        });
        ticking = false;
      });
    });
  }

  /* ── Per-page inits (re-run after each navigation) ── */
  function initObservers() {
    // chalk underline draw-in
    const chalkIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-drawn"); chalkIO.unobserve(e.target); }
      }),
      { threshold: 0.35 },
    );
    document.querySelectorAll(".chalk-underline").forEach((el) => chalkIO.observe(el));

    // section reveal
    const revealIO = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).style.animationDelay =
            (e.target as HTMLElement).dataset.delay ?? "0ms";
          e.target.classList.add("is-visible");
          revealIO.unobserve(e.target);
        }
      }),
      { threshold: 0.15 },
    );
    document.querySelectorAll(".reveal").forEach((el) => revealIO.observe(el));

    // typewriter
    document.querySelectorAll<HTMLElement>("[data-typewriter]").forEach((el) => {
      if (el.dataset.twDone) return;
      el.dataset.twDone = "1";
      const text = el.textContent ?? "";
      el.textContent = "";
      const cursor = document.createElement("span");
      cursor.className = "tw-cursor";
      el.appendChild(cursor);
      let i = 0;
      const twIO = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        twIO.disconnect();
        function type() {
          if (i < text.length) { cursor.before(text[i++]); setTimeout(type, 26 + Math.random() * 18); }
          else cursor.classList.add("tw-done");
        }
        type();
      }, { threshold: 0.6 });
      twIO.observe(el);
    });

    // magnetic buttons
    document.querySelectorAll<HTMLElement>(".btn").forEach((btn) => {
      btn.addEventListener("mousemove", (e) => {
        const r  = btn.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width  / 2)) * 0.28;
        const dy = (e.clientY - (r.top  + r.height / 2)) * 0.28 - 2;
        btn.style.transform = `translate(${dx}px,${dy}px)`;
        btn.style.boxShadow = btn.classList.contains("btn--ghost")
          ? "none"
          : `0 12px 34px rgba(240,138,28,0.4)`;
      });
      btn.addEventListener("mouseleave", () => {
        btn.style.transform = "";
        btn.style.boxShadow = "";
      });
    });

    // text scramble on chalk-underline spans
    const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#@&%—·";
    document.querySelectorAll<HTMLElement>(".chalk-underline").forEach((el) => {
      if (el.dataset.scrambleInit) return;
      el.dataset.scrambleInit = "1";
      const original = el.textContent ?? "";
      let timer: ReturnType<typeof setInterval> | null = null;

      el.addEventListener("mouseenter", () => {
        if (!el.classList.contains("is-drawn")) return;
        let progress = 0;
        clearInterval(timer!);
        timer = setInterval(() => {
          el.textContent = original
            .split("")
            .map((c, idx) => {
              if (/[\s&—–]/.test(c)) return c;
              if (idx < progress) return original[idx];
              return CHARS[Math.floor(Math.random() * CHARS.length)];
            })
            .join("");
          progress += 0.55;
          if (progress >= original.length) {
            clearInterval(timer!);
            el.textContent = original;
          }
        }, 32);
      });

      el.addEventListener("mouseleave", () => {
        clearInterval(timer!);
        el.textContent = original;
      });
    });
  }

  initObservers();
  document.addEventListener("astro:after-swap", initObservers);
</script>

<style is:global>
  /* ── Page transition: chalk dust ── */
  @keyframes chalk-out {
    from { opacity: 1; filter: blur(0)   brightness(1); }
    to   { opacity: 0; filter: blur(8px) brightness(1.5); }
  }
  @keyframes chalk-in {
    from { opacity: 0; filter: blur(8px) brightness(1.5); }
    to   { opacity: 1; filter: blur(0)   brightness(1); }
  }
  ::view-transition-old(root) { animation: 300ms ease-in  forwards chalk-out; }
  ::view-transition-new(root) { animation: 380ms 180ms ease-out both chalk-in; }

  /* ── Typewriter cursor ── */
  .tw-cursor {
    display: inline-block;
    width: 2px; height: 0.9em;
    background: var(--accent);
    margin-left: 3px;
    vertical-align: text-bottom;
    animation: tw-blink 0.75s step-end infinite;
  }
  .tw-cursor.tw-done { opacity: 0; animation: none; }
  @keyframes tw-blink { 50% { opacity: 0; } }

  /* ── Parallax elements: smooth follow ── */
  [data-parallax] {
    transition: transform 120ms ease-out;
    will-change: transform;
  }
</style>
