---
import Layout from "../../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { pageContext } from "../../lib/page-context";
import { absoluteUrl } from "../../i18n/locale";
import { franchiseServiceSchema, faqPageSchema } from "../../lib/seo";
import franchiseTuktukImg from '../../assets/uploads/franchise-tuktuk.webp';

const { locale, t, p } = pageContext(Astro.url.pathname);

const title = t.franchise.metaTitle;
const description = t.franchise.metaDescription;
const pageUrl = absoluteUrl(locale, "/franchise");
const pageSchema = [franchiseServiceSchema(pageUrl, description, locale), faqPageSchema(t.franchise.faq)];
---

<Layout locale={locale} {title} {description} schema={pageSchema}>
  <section class="section">
    <div class="container intro">
      <div class="intro__copy">
        <span class="h-sub">{t.franchise.eyebrow}</span>
        <h1 class="h-display"><span class="chalk-underline">{t.franchise.title}</span></h1>
        <p class="lead">{t.franchise.lead}</p>
        <div class="inline-action">
          <a class="btn" href={`${p("/kontakt")}?topic=${encodeURIComponent(t.common.topicValues.franchise)}#urlap`}>{t.franchise.ctaInterest}</a>
        </div>
      </div>
      <div class="photo-frame intro__photo"><Image src={franchiseTuktukImg} alt={t.franchise.heroImageAlt} widths={[400, 700]} sizes="(min-width: 820px) 50vw, 100vw" loading="eager" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container blocks stagger">
      <article class="block panel-motion">
        <h2 class="h-section block__title"><span class="chalk-underline">{t.franchise.whyTitle}</span></h2>
        <ul class="block__list chalk-list chalk-list--ruled">
          {t.franchise.benefits.map((item) => <li><span>{item}</span></li>)}
        </ul>
      </article>
      <article class="block panel-motion">
        <h2 class="h-section"><span class="chalk-underline">{t.franchise.packageTitle}</span></h2>
        <ul class="block__list block__list--compact chalk-list chalk-list--ruled">
          {t.franchise.packageItems.map((item) => <li><span>{item}</span></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section--last process-section">
    <div class="container">
      <div class="process-head">
        <span class="h-sub">{t.franchise.processTitle}</span>
        <h2 class="h-display"><span class="chalk-underline">{t.franchise.stepsTitle}</span></h2>
      </div>
      <ol class="steps stagger">
        {
          t.franchise.steps.map((s) => (
            <li class="step panel-motion">
              <span class="step__n panel-motion__badge">{s.n}</span>
              <div class="step__copy">
                <h3 class="h-section">{s.t}</h3>
                <p class="body-text">{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="inline-action steps__action">
        <a class="btn" href={`${p("/kontakt")}?topic=${encodeURIComponent(t.common.topicValues.franchise)}#urlap`}>{t.common.ctaJoinFranchise}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro { display: grid; gap: clamp(24px, 4vw, 48px); align-items: center; }
  @media (min-width: 820px) { .intro { grid-template-columns: 1fr 1fr; } }
  .intro__copy { display: grid; gap: 18px; }

  .blocks { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .blocks { grid-template-columns: 1fr 1fr; } }
  .block {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel-bg);
    box-shadow: var(--panel-shadow);
  }
  .block h2 { font-size: clamp(1.35rem, 2.3vw, 1.9rem); }
  .block__title {
    text-wrap: pretty;
  }
  @media (max-width: 819px) {
    .block h2 {
      line-height: 1.22;
    }
    .block__title .chalk-underline {
      display: inline;
      padding-bottom: 0.08em;
    }
  }
  @media (min-width: 820px) {
    .block__title {
      max-width: min(100%, 18ch);
      text-wrap: balance;
    }
  }
  .block__list span { text-wrap: pretty; }
  .keep-together { white-space: normal; }
  @media (min-width: 820px) {
    .keep-together { white-space: nowrap; }
  }
  .block__list--compact { gap: 0; }

  .process-head { display: grid; gap: var(--stack-tight); }
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.6vw, 20px);
    margin-top: var(--stack-loose);
    counter-reset: step;
  }
  @media (min-width: 620px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 980px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .step {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(18px, 2.2vw, 24px);
    align-content: start;
    min-height: 0;
    padding: clamp(20px, 2.8vw, 28px);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel-bg);
    box-shadow: var(--panel-shadow);
  }
  .step__n {
    display: inline-grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 1px solid rgba(240, 138, 28, 0.5);
    border-radius: 8px;
    font-family: var(--f-logo);
    color: var(--accent);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .step__copy {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .step h3 { font-size: clamp(1.45rem, 2.4vw, 2rem); }
  .step .body-text { font-size: clamp(1rem, 1.16vw, 1.08rem); line-height: 1.68; letter-spacing: 0.035em; text-wrap: pretty; }
  .steps__action {
    margin-top: clamp(20px, 3vw, 32px);
  }
</style>
