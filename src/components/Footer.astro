---
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from "../lib/contact";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid stagger">
    <div class="footer__col">
      <div class="footer__brand">BEAN &amp; BARREL</div>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kapcsolat</h4>
      <ul class="footer__list">
        <li><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kövess minket</h4>
      <ul class="footer__list footer__social">
        <li><a href="https://www.instagram.com/beanbarrel_bp?igsh=b2YzbWYzeXRnNDdr&utm_source=qr" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.facebook.com/share/1SxeQupYdp/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        <li><a href="https://www.tiktok.com/@beanbarrel_bp?_r=1&_t=ZN-96sdqSHL2R9" target="_blank" rel="noopener noreferrer">TikTok</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom container">
    <span>© {year} Bean &amp; Barrel</span>
    <nav class="footer__legal-nav" aria-label="Jogi">
      <a href="/impresszum">Impresszum</a>
      <span aria-hidden="true">·</span>
      <a href="/adatvedelem">Adatvédelem</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--main-footer-gap);
    padding-block: clamp(34px, 4.8vw, 56px) 22px;
    border-top: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.018), transparent 48%),
      var(--bg-2);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 38px);
    align-items: start;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(180px, 0.75fr));
      column-gap: clamp(36px, 6vw, 84px);
    }
  }

  .footer__col {
    display: grid;
    gap: 12px;
    align-content: start;
    justify-items: start;
  }

  .footer__brand {
    font-family: var(--f-logo);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .footer__brand::after {
    content: "";
    display: block;
    width: clamp(52px, 7vw, 78px);
    height: 1px;
    margin-top: 14px;
    background: var(--accent);
    opacity: 0.85;
  }

  .footer__col:first-child {
    min-height: 100%;
  }

  .footer__col h4 {
    margin: 0;
    padding-left: 0;
  }

  .footer__list {
    list-style: none;
    display: grid;
    gap: 7px;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .footer__list a {
    transition: color 180ms var(--ease);
  }
  .footer__list a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    margin-top: clamp(28px, 4vw, 40px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer__legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    justify-content: flex-end;
  }
  .footer__legal-nav span {
    color: var(--line);
  }
  .footer__legal-nav a {
    color: var(--ink-faint);
    transition: color 180ms var(--ease);
  }
  .footer__legal-nav a:hover { color: var(--accent); }

  @media (max-width: 719px) {
    .footer__bottom {
      align-items: flex-start;
    }

    .footer__legal-nav {
      justify-content: flex-start;
    }
  }

  /* Lebegő „Keress minket” gomb — jogi linkek ne essenek alá */
  @media (max-width: 640px) {
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-bottom: 76px;
    }

    .footer__legal-nav {
      width: 100%;
      max-width: calc(100% - 148px);
      justify-content: flex-start;
    }
  }

  @media (max-width: 520px) {
    .footer {
      padding-block: 28px 20px;
    }

    .footer__grid {
      gap: 22px;
    }

    .footer__bottom {
      gap: 10px;
      font-size: 0.78rem;
      line-height: 1.5;
    }
  }
</style>
