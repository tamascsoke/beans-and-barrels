---
import Layout from "../layouts/Layout.astro";
import HomeCarousel from "../components/HomeCarousel.astro";
---

<Layout title="Bean & Barrel — Kávé és Sör">
  <section class="hero">
    <div class="container hero__inner">
      <span class="h-sub">Kávé és sör — egy tuktukból</span>
      <h1 class="h-display hero__title" data-parallax="1.4">
        <span class="chalk-underline">Bean &amp; Barrel</span>
      </h1>
      <p class="lead hero__lead" data-typewriter data-parallax="0.7">
        Mozgó tuktuk kávézó és söröző, ami odamegy, ahol a közösség van. Esküvőkre, fesztiválokra, hétvégi pillanatokra.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/rendezvenyek">Rendezvényt kérek</a>
        <a class="btn btn--ghost" href="/kinalat">Nézd a kínálatot</a>
      </div>
    </div>
  </section>

  <HomeCarousel />

  <section class="section">
    <div class="container highlights">
      <article class="highlight">
        <div class="placeholder-img">Kép — Tuktuk</div>
        <h3 class="h-section"><span class="chalk-underline">Mobil — bárhol</span></h3>
        <p class="body-text">A tuktuk odamegy, ahol szükség van rá. Belváros, kerthelyiség, fesztivál.</p>
      </article>
      <article class="highlight">
        <div class="placeholder-img">Kép — Kávé</div>
        <h3 class="h-section"><span class="chalk-underline">Igazi specialty</span></h3>
        <p class="body-text">Pörkölőtől a poharadig — gondozott kávé, helyi pörkölőkkel együttműködve.</p>
      </article>
      <article class="highlight">
        <div class="placeholder-img">Kép — Sör</div>
        <h3 class="h-section"><span class="chalk-underline">Csapolt élmény</span></h3>
        <p class="body-text">Magyar kézműves csapok, koktélok és snackek a tuktuk pultjáról.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(50px, 10vw, 120px) clamp(20px, 4vw, 40px); }
  .hero__inner { display: grid; gap: 18px; max-width: 880px; }
  .hero__title { font-size: clamp(3rem, 9vw, 6.5rem); }
  .hero__lead { max-width: 56ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .highlights { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 760px) {
    .highlights { grid-template-columns: repeat(3, 1fr); }
  }
  .highlight { display: grid; gap: 14px; }
  .highlight h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); }
</style>
