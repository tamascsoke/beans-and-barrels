---
// Orange left-edge scroll progress bar
---

<div class="scroll-sidebar" aria-hidden="true">
  <div class="scroll-sidebar__fill" id="scrollFill"></div>
</div>

<style>
  .scroll-sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: rgba(240, 138, 28, 0.1);
    z-index: 30;
    pointer-events: none;
  }
  .scroll-sidebar__fill {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 0%;
    background: linear-gradient(to bottom, var(--accent), rgba(240,138,28,0.6));
    border-radius: 0 0 2px 2px;
    box-shadow: 1px 0 10px rgba(240,138,28,0.35);
  }
</style>

<script>
  function initScrollSidebar() {
    const fill = document.getElementById("scrollFill");
    function update() {
      if (!fill) return;
      const total = document.body.scrollHeight - window.innerHeight;
      fill.style.height = (total > 0 ? Math.min(window.scrollY / total, 1) : 0) * 100 + "%";
    }
    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  initScrollSidebar();
  document.addEventListener("astro:after-swap", initScrollSidebar);
</script>
