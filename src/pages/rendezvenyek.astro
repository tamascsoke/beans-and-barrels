---
import Layout from "../layouts/Layout.astro";
import { getReasons } from "../lib/content";
import eventTypes from "../content/event-types.json";

const reasons = getReasons();
const events = eventTypes.items;
---

<Layout title="Rendezvények — Bean & Barrel">
  <section class="section">
    <div class="container intro">
      <span class="h-sub">Rendezvények</span>
      <h1 class="h-display"><span class="chalk-underline">Hozd a tuktukot</span></h1>
      <p class="lead">
        Hozzád megyünk. Bean & Barrel a helyszínen készíti a specialty kávét, csapolja a sört és kavarja a koktélt
        — az alkalmadra szabva.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/kontakt">Kérek ajánlatot</a>
      </div>
    </div>
  </section>

  <section class="section" id="miert">
    <div class="container">
      <span class="h-sub">Miért minket válassz</span>
      <h2 class="h-display"><span class="chalk-underline">Négy ok, egy tuktuk</span></h2>
      <div class="reasons stagger">
        {
          reasons.map((r, i) => (
            <article class="reason">
              <span class="reason__n">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h-section">{r.title}</h3>
              <p class="body-text">{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container events">
      <div>
        <span class="h-sub">Milyen alkalmakra?</span>
        <h2 class="h-section"><span class="chalk-underline">Tipikus rendezvények</span></h2>
        <ul class="events__list stagger">
          {events.map((e) => <li>{e}</li>)}
        </ul>
      </div>
      <div class="photo-frame events__photo"><img src="/uploads/halloween.webp" alt="Bean & Barrel rendezvény hangulat" decoding="async" /></div>
    </div>
  </section>
</Layout>

<style>
  .intro { display: grid; gap: 18px; max-width: 820px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .section--alt { background: var(--bg-2); }

  .reasons {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    margin-top: 30px;
  }
  @media (min-width: 760px) { .reasons { grid-template-columns: repeat(2, 1fr); } }

  .reason {
    display: grid;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: rgba(255,255,255,0.015);
    transition: transform 280ms var(--ease), box-shadow 280ms var(--ease), border-color 280ms var(--ease), background 280ms var(--ease);
  }
  .reason:hover {
    transform: translateY(-4px) scale(1.015);
    border-color: rgba(240, 138, 28, 0.45);
    background: rgba(240, 138, 28, 0.04);
    box-shadow: 0 14px 40px rgba(0,0,0,0.35);
  }
  .reason__n { font-family: var(--f-logo); color: var(--accent); font-size: 1.6rem; letter-spacing: var(--ls-body); }
  .reason h3 { font-size: clamp(1.2rem, 2.2vw, 1.6rem); }

  .events {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
  }
  @media (min-width: 760px) { .events { grid-template-columns: 1fr 1fr; } }

  .events__list {
    list-style: none;
    display: grid;
    gap: 6px;
    margin-top: 16px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .events__list li::before { content: "—  "; color: var(--accent); }
  .events__photo { aspect-ratio: 4 / 3; }
</style>
