---
import { PHONE_DISPLAY, PHONE_HREF, EMAIL } from "../lib/contact";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__cta">
    <div class="footer__cta-copy">
      <span class="h-sub">Rendezvényre készülsz?</span>
      <p>Rendeld meg a tuktukot a rendezvényedre!</p>
    </div>
    <a class="btn" href="/rendezvenyek">Rendeld meg a tuktukot a rendezvényedre!</a>
  </div>

  <div class="container footer__grid stagger">
    <div class="footer__col">
      <div class="footer__brand">BEAN &amp; BARREL</div>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kapcsolat</h4>
      <ul class="footer__list">
        <li><a href={`tel:${PHONE_HREF}`}>{PHONE_DISPLAY}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="h-sub">Kövess minket</h4>
      <ul class="footer__list footer__social">
        <li><a href="https://www.instagram.com/beanbarrel_bp?igsh=b2YzbWYzeXRnNDdr&utm_source=qr" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.facebook.com/share/1SxeQupYdp/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        <li><a href="https://www.tiktok.com/@beanbarrel_bp?_r=1&_t=ZN-96sdqSHL2R9" target="_blank" rel="noopener noreferrer">TikTok</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom container">
    <span>© {year} Bean &amp; Barrel</span>
    <nav class="footer__legal-nav" aria-label="Jogi">
      <a href="/impresszum">Impresszum</a>
      <span aria-hidden="true">·</span>
      <a href="/adatvedelem">Adatvédelem</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(60px, 10vw, 120px);
    padding-block: clamp(40px, 6vw, 70px) 24px;
    border-top: 1px solid var(--line);
    background: var(--bg-2);
  }

  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 28px;
    margin-bottom: clamp(34px, 5vw, 58px);
    padding-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
  }

  .footer__cta-copy {
    display: grid;
    gap: 8px;
    min-width: min(100%, 320px);
  }

  .footer__cta-copy p {
    font-family: var(--f-logo);
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__cta .btn {
    max-width: 100%;
    justify-content: center;
    text-align: center;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  .footer__brand {
    font-family: var(--f-logo);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .footer__col:first-child {
    display: flex;
    align-items: center;
    min-height: 100%;
  }

  .footer__col h4 {
    margin-bottom: 14px;
  }

  .footer__list {
    list-style: none;
    display: grid;
    gap: 8px;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .footer__list a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer__legal-nav {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .footer__legal-nav a {
    color: var(--ink-faint);
    transition: color 180ms var(--ease);
  }
  .footer__legal-nav a:hover { color: var(--accent); }
  .footer__legal:hover {
    color: var(--accent);
  }
</style>
