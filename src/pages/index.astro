---
import Layout from "../layouts/Layout.astro";
import HomeCarousel from "../components/HomeCarousel.astro";
import GalleryStrip from "../components/GalleryStrip.astro";
---

<Layout title="Bean & Barrel — Kávé és Sör">
  <section class="hero">
    <div class="container hero__inner">
      <span class="h-sub">Kávé és sör — egy tuktukból</span>
      <h1 class="h-display hero__title" data-parallax="1.4">
        <span class="chalk-underline">Bean &amp; Barrel</span>
      </h1>
      <p class="lead hero__lead" data-typewriter data-parallax="0.7">
        Mozgó tuktuk kávézó és söröző, ami odamegy, ahol a közösség van. Esküvőkre, fesztiválokra, hétvégi pillanatokra.
      </p>
      <div class="hero__cta">
        <a class="btn" href="/kontakt">Rendezvényt kérek</a>
        <a class="btn btn--ghost" href="/kinalat">Nézd a kínálatot</a>
      </div>
    </div>
  </section>

  <HomeCarousel />

  <section class="section">
    <div class="container highlights">
      <article class="highlight">
        <div class="photo-frame"><img src="/uploads/tuktuk-kave.webp" alt="Bean & Barrel tuktuk kávézással" decoding="async" /></div>
        <h3 class="h-section"><span class="chalk-underline">Mobil — bárhol</span></h3>
        <p class="body-text">A tuktuk odamegy, ahol szükség van rá. Belváros, kerthelyiség, fesztivál.</p>
      </article>
      <article class="highlight">
        <div class="photo-frame"><img src="/uploads/kave.webp" alt="Specialty kávé közelről" decoding="async" /></div>
        <h3 class="h-section"><span class="chalk-underline">Igazi specialty</span></h3>
        <p class="body-text">Pörkölőtől a poharadig — gondozott kávé, helyi pörkölőkkel együttműködve.</p>
      </article>
      <article class="highlight">
        <div class="photo-frame"><img src="/uploads/sor.webp" alt="Csapolt kézműves sör" decoding="async" /></div>
        <h3 class="h-section"><span class="chalk-underline">Csapolt élmény</span></h3>
        <p class="body-text">Magyar kézműves csapok, koktélok és snackek a tuktuk pultjáról.</p>
      </article>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container about-teaser">
      <div class="about-teaser__intro">
        <span class="h-sub">Rólunk</span>
        <h2 class="h-display"><span class="chalk-underline">Három srác, egy tuktuk</span></h2>
        <p class="lead">
          A Bean & Barrel három barát közös története. Hiszünk benne, hogy egy jó kávé és egy hideg sör közelebb hozza az embereket — bárhol legyen is a tuktuk.
        </p>
        <a class="btn btn--ghost" href="/rolunk">Ismerj meg minket</a>
      </div>
      <div class="about-teaser__team stagger">
        <div class="team-card">
          <div class="team-card__photo placeholder-img">Portré — Soós Balázs</div>
          <div class="team-card__info">
            <span class="team-card__name">Soós Balázs</span>
            <span class="team-card__role">Alapító — kávé</span>
          </div>
        </div>
        <div class="team-card">
          <div class="team-card__photo placeholder-img">Portré — Warta Benedek</div>
          <div class="team-card__info">
            <span class="team-card__name">Warta Benedek</span>
            <span class="team-card__role">Alapító — sör</span>
          </div>
        </div>
        <div class="team-card">
          <div class="team-card__photo placeholder-img">Portré — Váradi Donát</div>
          <div class="team-card__info">
            <span class="team-card__name">Váradi Donát</span>
            <span class="team-card__role">Alapító — közösség</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <GalleryStrip />
</Layout>

<style>
  .hero { padding-block: clamp(50px, 10vw, 120px) clamp(20px, 4vw, 40px); }
  .hero__inner { display: grid; gap: 18px; max-width: 880px; }
  .hero__title { font-size: clamp(3rem, 9vw, 6.5rem); }
  .hero__lead { max-width: 56ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .section--alt { background: var(--bg-2); }

  /* About teaser */
  .about-teaser {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  @media (min-width: 820px) {
    .about-teaser { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  .about-teaser__intro { display: grid; gap: 18px; }

  .about-teaser__team { display: grid; gap: 16px; }
  .team-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .team-card:first-child { border-top: 1px solid var(--line); }
  .team-card__photo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-md);
    font-size: 0;
    transform: none;
  }
  .team-card__photo::before,
  .team-card__photo::after { content: none; }
  .team-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .team-card__name {
    font-family: var(--f-logo);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .team-card__role {
    font-family: var(--f-sub);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .highlights { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 760px) {
    .highlights { grid-template-columns: repeat(3, 1fr); }
  }
  .highlight { display: grid; gap: 14px; }
  .highlight h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); }
</style>
