---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { franchiseServiceSchema, faqPageSchema, type FaqItem } from "../lib/seo";
import franchiseTuktukImg from '../assets/uploads/franchise-tuktuk.webp';

const benefits = [
  "Bejáratott brand és arculat – nem kell mindent a nulláról kitalálnod. Mi már megtettük. Rád csak annyi vár, hogy képviseld és élvezd minden velejáróját.",
  "Egyszerű modell – egy kis hely, kevés költség, kreatív koncepció, gyors megtérülés. Kávé, SÖR, pár minőségi snack – nincs túlbonyolítva.",
];

const packageItems = [
  "TELJES MÁRKACSOMAG",
  "MINDEN KNOW-HOW",
  "BARISTA ÉS CSAPOS BETANÍTÁS",
  "MARKETING ÉS KAMPÁNYSTRATÉGIA",
  "HOZZÁFÉRÉS A BESZÁLLÍTÓI HÁLÓZATHOZ",
  "FOLYAMATOS KAPCSOLATTARTÁS",
];

const steps = [
  { n: "01", t: "Jelentkezz", d: "Vedd fel velünk a kapcsolatot." },
  { n: "02", t: "Beszélgetünk", d: "Nem interjú, inkább egy laza kávé/SÖR mellett (termékteszt)." },
  { n: "03", t: "Megmutatjuk a modellt", d: "Számokkal, képekkel, tuktukkal." },
  { n: "04", t: "Üdv a csapatban", d: "Tuktuk beizzítva, sztori indul." },
];

const faqItems: FaqItem[] = [
  {
    question: "Ki lehet Bean & Barrel franchise-partner?",
    answer: "Olyan vállalkozó vagy csapat, aki szeretne egy bejáratott mozgó tuktuk (tuk tuk) kávézó-söröző koncepciót képviselni Magyarországon, és nyitott a közös munkára velünk.",
  },
  {
    question: "Mennyi a franchise befektetés?",
    answer: "A pontos összeg a helyszíntől és a modelltől függ. Az első beszélgetés után átlátható számokkal mutatjuk meg a lehetőségeket.",
  },
  {
    question: "Milyen támogatást kapok induláskor?",
    answer: "Teljes márkacsomagot, know-how-t, barista és csapos betanítást, marketing irányt, beszállítói hozzáférést és folyamatos kapcsolattartást.",
  },
  {
    question: "Hol működhet egy franchise egység?",
    answer: "Irodaházak, sétálóutcák, rendezvények és egyéb forgalmas helyszínek mellett — Magyarországon, ahol van kereslet a mozgó specialty kávé és csapolt sör élményre.",
  },
  {
    question: "Hogyan jelentkezek franchise-partnernek?",
    answer: "Töltsd ki a kapcsolatfelvételi űrlapot a Franchise témával, és hamarosan felvesszük veled a kapcsolatot.",
  },
];

const title = "Tuktuk franchise Magyarország | Bean & Barrel";
const description = "Bean & Barrel tuktuk (tuk tuk) franchise Magyarországon: mozgó kávézó-söröző koncepció, know-how, betanítás és folyamatos támogatás. Jelentkezz partnernek!";
const pageUrl = "https://www.beanbarrel.coffee/franchise";
const pageSchema = [franchiseServiceSchema(pageUrl, description), faqPageSchema(faqItems)];
---

<Layout {title} {description} schema={pageSchema}>
  <section class="section">
    <div class="container intro">
      <div class="intro__copy">
        <span class="h-sub">Franchise</span>
        <h1 class="h-display"><span class="chalk-underline">Kávézz, SÖRÖZZ velünk!</span></h1>
        <p class="lead">
          Az országban rengeteg helyen van szükség a Bean&amp;Barrel-re. Irodák, sétálóutcák, rendezvények,
          lehetőségek tömkelege. Csatlakozz hozzánk, Magyarország jövendőbeli legnagyobb mozgó
          kávézó-SÖRÖZŐ hálózatához!
        </p>
        <div class="inline-action">
          <a class="btn" href="/kontakt?topic=Franchise#urlap">Érdekel a franchise</a>
        </div>
      </div>
      <div class="photo-frame intro__photo"><Image src={franchiseTuktukImg} alt="Bean & Barrel tuktuk rendezvény közben" widths={[400, 700]} sizes="(min-width: 820px) 50vw, 100vw" loading="eager" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container blocks stagger">
      <article class="block panel-motion">
        <h2 class="h-section block__title"><span class="chalk-underline">Miért érdemes <span class="keep-together">franchise-partnernek</span> lenni?</span></h2>
        <ul class="block__list chalk-list chalk-list--ruled">
          {benefits.map((item) => <li><span>{item}</span></li>)}
        </ul>
      </article>
      <article class="block panel-motion">
        <h2 class="h-section"><span class="chalk-underline">Mit kapsz?</span></h2>
        <ul class="block__list block__list--compact chalk-list chalk-list--ruled">
          {packageItems.map((item) => <li><span>{item}</span></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section section--last process-section">
    <div class="container">
      <div class="process-head">
        <span class="h-sub">Folyamat</span>
        <h2 class="h-display"><span class="chalk-underline">A csatlakozás menete</span></h2>
      </div>
      <ol class="steps stagger">
        {
          steps.map((s) => (
            <li class="step panel-motion">
              <span class="step__n panel-motion__badge">{s.n}</span>
              <div class="step__copy">
                <h3 class="h-section">{s.t}</h3>
                <p class="body-text">{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="inline-action steps__action">
        <a class="btn" href="/kontakt?topic=Franchise#urlap">Csatlakozni szeretnék</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro { display: grid; gap: clamp(24px, 4vw, 48px); align-items: center; }
  @media (min-width: 820px) { .intro { grid-template-columns: 1fr 1fr; } }
  .intro__copy { display: grid; gap: 18px; }

  .blocks { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .blocks { grid-template-columns: 1fr 1fr; } }
  .block {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel-bg);
    box-shadow: var(--panel-shadow);
  }
  .block h2 { font-size: clamp(1.35rem, 2.3vw, 1.9rem); }
  .block__title {
    text-wrap: pretty;
  }
  @media (max-width: 819px) {
    .block h2 {
      line-height: 1.22;
    }
    .block__title .chalk-underline {
      display: inline;
      padding-bottom: 0.08em;
    }
  }
  @media (min-width: 820px) {
    .block__title {
      max-width: min(100%, 18ch);
      text-wrap: balance;
    }
  }
  .block__list span { text-wrap: pretty; }
  .keep-together { white-space: normal; }
  @media (min-width: 820px) {
    .keep-together { white-space: nowrap; }
  }
  .block__list--compact { gap: 0; }

  .process-head { display: grid; gap: var(--stack-tight); }
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.6vw, 20px);
    margin-top: var(--stack-loose);
    counter-reset: step;
  }
  @media (min-width: 620px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 980px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .step {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(18px, 2.2vw, 24px);
    align-content: start;
    min-height: 0;
    padding: clamp(20px, 2.8vw, 28px);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel-bg);
    box-shadow: var(--panel-shadow);
  }
  .step__n {
    display: inline-grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 1px solid rgba(240, 138, 28, 0.5);
    border-radius: 8px;
    font-family: var(--f-logo);
    color: var(--accent);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .step__copy {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .step h3 { font-size: clamp(1.45rem, 2.4vw, 2rem); }
  .step .body-text { font-size: clamp(1rem, 1.16vw, 1.08rem); line-height: 1.68; letter-spacing: 0.035em; text-wrap: pretty; }
  .steps__action {
    margin-top: clamp(20px, 3vw, 32px);
  }
</style>
