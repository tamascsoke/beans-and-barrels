---
const slides = [
  {
    eyebrow: "Rendezvények",
    title: "Hozd a tuktukot a buliba",
    body: "Esküvők, céges napok, fesztiválok — Bean & Barrel a helyszínen készíti a kávét és csapolja a sört.",
    cta: { href: "/rendezvenyek", label: "Rendezvényt kérek" },
  },
  {
    eyebrow: "Helyszínek",
    title: "Hol találsz minket?",
    body: "Budapesttől a Balatonig — kövesd a tuktukot a városban, vagy nézd meg a következő állomásokat.",
    cta: { href: "/kinalat", label: "Nézd a kínálatot" },
  },
  {
    eyebrow: "Történetek",
    title: "Mi van a poharak mögött",
    body: "Cikkek, interjúk és pillanatképek a Bean & Barrel közösségéből.",
    cta: { href: "/rolunk", label: "Ismerd meg a csapatot" },
  },
];
---

<section class="carousel" aria-roledescription="carousel">
  <div class="carousel__track" id="carouselTrack">
    {
      slides.map((s, i) => (
        <article class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`}>
          <div class="carousel__art placeholder-img">{`Kép — ${s.eyebrow.toUpperCase()}`}</div>
          <div class="carousel__copy">
            <span class="h-sub">{s.eyebrow}</span>
            <h2 class="h-display"><span class="chalk-underline">{s.title}</span></h2>
            <p class="lead">{s.body}</p>
            <a class="btn" href={s.cta.href}>{s.cta.label}</a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="carousel__dots" role="tablist">
    {slides.map((_, i) => (
      <button class="carousel__dot" data-i={i} aria-label={`Csúsz ${i + 1}`}></button>
    ))}
  </div>
</section>

<style>
  .carousel {
    position: relative;
    overflow: hidden;
  }
  .carousel__track {
    display: flex;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    padding-inline: var(--gutter);
    padding-block: clamp(40px, 7vw, 80px);
    max-width: var(--max-w);
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 860px) {
    .carousel__slide {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .carousel__art {
    aspect-ratio: 4 / 3;
    width: 100%;
  }

  .carousel__copy {
    display: grid;
    gap: 18px;
    align-content: center;
  }
  .carousel__copy .btn {
    justify-self: start;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding-bottom: 30px;
  }
  .carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink-faint);
    transition: background 200ms var(--ease), transform 200ms var(--ease);
  }
  .carousel__dot.is-active {
    background: var(--accent);
    transform: scale(1.3);
  }
</style>

<script>
  const track = document.getElementById("carouselTrack");
  const dots = Array.from(document.querySelectorAll(".carousel__dot")) as HTMLButtonElement[];
  if (track && dots.length) {
    const setActive = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, idx) => d.classList.toggle("is-active", idx === i));
    };
    track.addEventListener("scroll", () => requestAnimationFrame(setActive), { passive: true });
    dots.forEach((d, i) =>
      d.addEventListener("click", () => track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" })),
    );
    setActive();
  }
</script>
