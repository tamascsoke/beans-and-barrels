---
// TuktukProgress.astro — road strip + rolling tuktuk scroll indicator
---

<div class="tkp" id="tkProgress" aria-hidden="true">
  <div class="tkp__road">
    <div class="tkp__fill" id="tkFill"></div>
    <div class="tkp__vehicle" id="tkVehicle">
      <img src="/tuktuk-logo.webp" alt="" />
    </div>
  </div>
</div>

<style>
  .tkp {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    pointer-events: none;
    padding: 0 var(--gutter);
    opacity: 0;
    transition: opacity 400ms;
  }
  .tkp.is-visible { opacity: 1; }

  .tkp__road {
    position: relative;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: visible;
  }

  /* dashed centre line */
  .tkp__road::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0; right: 0;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255,255,255,0.15) 0 10px,
      transparent 10px 22px
    );
    transform: translateY(-50%);
  }

  .tkp__fill {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, rgba(240,138,28,0.7) 100%);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 60ms linear;
  }

  /* vehicle sits on the road — bottom pinned to road bottom */
  .tkp__vehicle {
    position: absolute;
    bottom: 0;
    left: 0;
    transform: translateX(-50%);
    height: 36px;
    transition: left 60ms linear;
  }

  /* faces right by default (scrolling down) */
  .tkp__vehicle img {
    height: 100%;
    width: auto;
    display: block;
    transform: scaleX(-1);
    transition: transform 220ms var(--ease);
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.55));
  }

  /* flip to face left when scrolling up */
  .tkp--up .tkp__vehicle img { transform: scaleX(1); }
</style>

<script>
  const bar     = document.getElementById("tkProgress");
  const fill    = document.getElementById("tkFill");
  const vehicle = document.getElementById("tkVehicle");

  let prevScrollY = window.scrollY;

  function update() {
    const scrolled = window.scrollY;
    const total    = document.body.scrollHeight - window.innerHeight;
    if (total <= 0) return;
    const pct = Math.min(scrolled / total, 1);

    if (scrolled > prevScrollY)      bar!.classList.remove("tkp--up");
    else if (scrolled < prevScrollY) bar!.classList.add("tkp--up");
    prevScrollY = scrolled;

    fill!.style.transform = `scaleX(${pct})`;
    vehicle!.style.left   = `${pct * 100}%`;

    if (pct > 0.01 && pct < 0.999) bar!.classList.add("is-visible");
    else bar!.classList.remove("is-visible");
  }

  window.addEventListener("scroll", update, { passive: true });
  document.addEventListener("astro:after-swap", () => {
    prevScrollY = window.scrollY;
    update();
  });
</script>
